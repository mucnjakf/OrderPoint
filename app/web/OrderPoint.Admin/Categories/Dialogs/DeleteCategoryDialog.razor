<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error"/>
            <MudText Typo="Typo.h6">Delete category</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mb-4">
            <MudText Typo="Typo.body2">
                This action cannot be undone.
            </MudText>
        </MudAlert>

        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <MudImage Src="@(Category.ImageUrl ?? ImageUrls.Placeholder)"
                          Alt="Category image"
                          Width="72"
                          Height="72"
                          ObjectFit="ObjectFit.Cover"
                          Style="@ImageStyles.Rounded"/>

                <MudStack Spacing="1" Class="flex-1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">
                            @Category.Name
                        </MudText>

                        <MudChip T="string"
                                 Variant="Variant.Text"
                                 Size="Size.Small"
                                 Color="@(Category.Status is CategoryStatus.Active ? Color.Success : Color.Error)">
                            @Category.Status.ToString()
                        </MudChip>
                    </MudStack>

                    <MudText Typo="Typo.body2">
                        @Category.Description
                    </MudText>

                    <MudText Typo="Typo.caption">
                        Created @Category.CreatedAtUtc.ToRelativeTime()
                    </MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (Category.ImageUrl is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-4 mb-2">
                This also deletes:
            </MudText>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small"/>
                <MudText Typo="Typo.body2">The category image</MudText>
            </MudStack>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
            Cancel
        </MudButton>

        <MudButton OnClick="@Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete">
            Delete @Category.Name
        </MudButton>
    </DialogActions>
</MudDialog>