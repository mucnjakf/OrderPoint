<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.SwapVert"/>
            <MudText Typo="Typo.h6">Reorder categories</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--mud-palette-text-secondary)">
            Drag the categories into the order customers will see them in the menu.
        </MudText>

        <StatefulView IsLoading="@IsLoading"
                      ShowContent="@Categories.Any()"
                      EmptyStateIcon="@Icons.Material.Filled.Category"
                      EmptyStateText="No categories found">
            <LoadingContent>
                <ReorderCategoriesSkeleton/>
            </LoadingContent>

            <ChildContent>
                <MudDropContainer @ref="@DropContainer"
                                  T="CategoryDto"
                                  Items="@Categories"
                                  ItemsSelector="@((category, zone) => true)"
                                  ItemDropped="@OnCategoryDropped">
                    <ChildContent>
                        <MudDropZone T="CategoryDto"
                                     Identifier="categories"
                                     AllowReorder="true"
                                     Class="d-flex flex-column gap-2"/>
                    </ChildContent>

                    <ItemRenderer>
                        <MudPaper Outlined="true" Class="pa-3" Style="cursor: grab;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                         Style="color: var(--mud-palette-text-secondary);"/>

                                <MudText Typo="Typo.body2" Style="width: 20px;">
                                    @GetPosition(context)
                                </MudText>

                                <MudImage Src="@(context.ImageUrl ?? ImageUrls.Placeholder)"
                                          Alt="Category image"
                                          Width="40"
                                          Height="40"
                                          ObjectFit="ObjectFit.Cover"
                                          Style="@ImageStyles.Rounded"/>

                                <MudText Typo="Typo.body1" Class="flex-1">
                                    @context.Name
                                </MudText>

                                <MudChip T="string"
                                         Variant="Variant.Text"
                                         Size="Size.Small"
                                         Color="@(context.Status is CategoryStatus.Active
                                                      ? Color.Success
                                                      : Color.Error)">
                                    @context.Status.ToString()
                                </MudChip>
                            </MudStack>
                        </MudPaper>
                    </ItemRenderer>
                </MudDropContainer>
            </ChildContent>
        </StatefulView>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
            Cancel
        </MudButton>

        <MudButton OnClick="@Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(!IsOrderChanged)">
            Save order
        </MudButton>
    </DialogActions>
</MudDialog>