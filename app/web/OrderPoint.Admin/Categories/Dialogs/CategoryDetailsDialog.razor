<MudDialog ActionsClass="pa-6" Style="background-color: #32333d">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Category"/>
            <MudText Typo="Typo.h6">Category details</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3" Class="mb-5">
            <MudItem xs="12" md="4">
                <CategoryPreviewPaper ImageUrl="@Category.ImageUrl"
                                      Name="@Category.Name"
                                      Description="@Category.Description"
                                      Status="@Category.Status"/>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-5" Style="height: 100%">
                    <TextDisplayRow Icon="@Icons.Material.Filled.Numbers"
                                    Label="ID"
                                    Text="@Category.Id.ToString()"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.ShortText"
                                    Label="Name"
                                    Text="@Category.Name"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Description"
                                    Label="Description"
                                    Text="@Category.Description"
                                    ShowDivider="true"/>

                    <ChipDisplayRow Icon="@Icons.Material.Filled.MonitorHeart"
                                    Label="Status"
                                    Text="@Category.Status.ToString()"
                                    Color="@(Category.Status is CategoryStatus.Active ? Color.Success : Color.Error)"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                    Label="Created"
                                    Text="@Category.CreatedAtUtc.ToString("G")"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                    Label="Updated"
                                    Text="@(Category.UpdatedAtUtc.HasValue ? Category.UpdatedAtUtc.Value.ToString("G") : "-")"/>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <DataList TItem="ItemDto"
                  Items="Items"
                  Pagination="Pagination"
                  IsLoading="IsLoading"
                  SelectedSortBy="@SelectedSortBy"
                  SelectedSortByChanged="@(value => SelectedSortBy = value)"
                  SearchLabel="Search by name"
                  SearchQuery="@SearchQuery"
                  SearchQueryChanged="@(value => SearchQuery = value)"
                  OnSearchChanged="@OnSearchChangedAsync"
                  OnSortChanged="@OnSortChangedAsync"
                  OnPageChanged="@OnPageChanged"
                  SortByOptions="@Enum.GetNames(typeof(ItemSortBy))"
                  GetSortByLabel="@ItemSorting.GetSortByLabel"
                  GetSortByIcon="@ItemSorting.GetSortByIcon"
                  EmptyStateIcon="@Icons.Material.Filled.MenuBook"
                  EmptyStateText="@("No items found")">

            <RowTemplate>
                <MudStack Row="true" Class="d-flex justify-space-between">
                    <MudStack Row="true">
                        <MudCardMedia Image="@(context.ImageUrl ?? "images/image-placeholder.svg")"
                                      Style="@(context.ImageUrl is null ? "width: 50px; height: 50px;" : string.Empty)"/>

                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body1">
                                @context.Name
                            </MudText>

                            <MudText Typo="Typo.caption">
                                @context.Description
                            </MudText>
                        </MudStack>

                    </MudStack>

                    <MudStack Spacing="1" Class="align-end">
                        <MudText Typo="Typo.body1">
                            @context.Portion x @context.Price.ToString("C", CultureInfo.CurrentCulture)
                        </MudText>

                        <MudText Typo="Typo.caption">
                            @context.CreatedAtUtc.ToString("G")
                        </MudText>
                    </MudStack>
                </MudStack>
            </RowTemplate>
        </DataList>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   OnClick="Close"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>