<MudStack Row="true" Class="d-flex justify-space-between">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="36px" Height="36px"/>

        <MudStack Spacing="1">
            <MudText Typo="Typo.body1">
                <MudSkeleton Width="140px"/>
            </MudText>

            <MudText Typo="Typo.caption">
                <MudSkeleton Width="220px"/>
            </MudText>
        </MudStack>
    </MudStack>

    <MudStack Row="true" Class="align-center">
        <MudStack Spacing="1" Class="align-end">
            <MudText Typo="Typo.body1">
                <MudSkeleton Width="90px"/>
            </MudText>

            <MudText Typo="Typo.caption">
                <MudSkeleton Width="80px"/>
            </MudText>
        </MudStack>

        <MudDivider Vertical="true"/>

        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="30px" Height="30px"/>
    </MudStack>
</MudStack>