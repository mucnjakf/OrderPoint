<HighlightCard Label="@($"#{Rank}")"
               Icon="@Icons.Material.Filled.EmojiEvents"
               Color="Color.Primary"
               IsLoading="false"
               ShowContent="true"
               OnClick="@OnCardClickAsync">
    <MudImage Src="@(Category.ImageUrl ?? ImageUrls.Placeholder)"
              Alt="Category image"
              Class="mt-2 mb-3"
              Width="40"
              Height="40"
              Style="@ImageStyles.Rounded"/>

    <MudText Typo="Typo.body1" Align="Align.Center">
        @Category.Name
    </MudText>

    <MudChip T="string"
             Variant="Variant.Text"
             Size="Size.Small"
             Color="@(Category.Status is CategoryStatus.Active ? Color.Success : Color.Error)">
        @Category.Status.ToString()
    </MudChip>

    <MudText Typo="Typo.h6">
        @Category.ItemsCount.ToCountText("item", "items")
    </MudText>
</HighlightCard>