@page "/categories"

<PageTitle>Categories</PageTitle>

<PageHeader Text="Categories" Breadcrumbs="@Breadcrumbs"/>

<StatefulView IsLoading="@IsLoadingTop"
              ShowContent="@TopCategories.Any()"
              EmptyStateIcon="@Icons.Material.Filled.Category"
              EmptyStateText="No categories found">
    <LoadingContent>
        <TopCategoriesSkeleton Count="@TopCategoriesCount"/>
    </LoadingContent>

    <ChildContent>
        <MudStack Row="true" Spacing="3" Class="mb-5">
            @for (int i = 0; i < TopCategories.Count; i++)
            {
                <TopCategoryCard Rank="@(i + 1)"
                                 Category="@TopCategories[i]"
                                 OnClick="@ShowCategoryDetailsDialogAsync"/>
            }
        </MudStack>
    </ChildContent>
</StatefulView>

<DataTable TItem="CategoryDto"
           Items="@Categories"
           Pagination="@Pagination"
           IsLoading="@IsLoading"
           SearchLabel="Search by name"
           SearchQuery="@SearchQuery"
           SearchQueryChanged="@(value => SearchQuery = value)"
           SelectedSortBy="@SelectedSortBy"
           SelectedSortByChanged="@(value => SelectedSortBy = value)"
           OnSearchChanged="@OnSearchChangedAsync"
           OnSortChanged="@OnSortChangedAsync"
           OnPageChanged="@OnPageChangedAsync"
           SortByOptions="@CategorySorting.SortByOptions"
           GetSortByLabel="@CategorySorting.GetSortByLabel"
           GetSortByIcon="@CategorySorting.GetSortByIcon"
           CreateButtonText="New category"
           OnCreateClick="@ShowCreateCategoryDialogAsync"
           OnDetailsClick="@ShowCategoryDetailsDialogAsync"
           OnUpdateClick="@ShowUpdateCategoryDialogAsync"
           DeleteButtonDisabled="@(category => category.ItemsCount > 0)"
           DeleteButtonDisabledTooltipText="Category contains items"
           OnDeleteClick="@ShowDeleteCategoryDialogAsync"
           @bind-SelectedItems="@SelectedCategories"
           EmptyStateIcon="@Icons.Material.Filled.Category"
           EmptyStateText="No categories found">

    <LoadingTemplate>
        <CategoryRowSkeleton/>
    </LoadingTemplate>

    <ToolbarActionsContent>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.SwapVert"
                   OnClick="@ShowReorderCategoriesDialogAsync">
            Reorder
        </MudButton>
    </ToolbarActionsContent>

    <BulkActionsTemplate>
        <MudButton Variant="Variant.Text"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.CheckCircle"
                   OnClick="@(() => ShowChangeCategoriesStatusDialogAsync(CategoryStatus.Active))">
            Activate
        </MudButton>

        <MudButton Variant="Variant.Text"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Block"
                   OnClick="@(() => ShowChangeCategoriesStatusDialogAsync(CategoryStatus.Inactive))">
            Deactivate
        </MudButton>

        <MudTooltip Text="@DeleteSelectedTooltipText">
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@IsDeleteSelectedBlocked"
                       OnClick="@ShowDeleteCategoriesDialogAsync">
                Delete
            </MudButton>
        </MudTooltip>
    </BulkActionsTemplate>

    <FilterContent>
        <MudSelect @bind-Value="@SelectedStatus"
                   @bind-Value:after="@OnStatusChangedAsync"
                   T="CategoryStatus?"
                   Variant="Variant.Outlined"
                   Label="Status"
                   FitContent="true">

            <MudSelectItem Value="@(null)" T="CategoryStatus?">
                <MudText>All</MudText>
            </MudSelectItem>

            @foreach (CategoryStatus status in Enum.GetValues<CategoryStatus>())
            {
                <MudSelectItem Value="@status" T="CategoryStatus?">
                    <MudText>
                        @status.ToString()
                    </MudText>
                </MudSelectItem>
            }
        </MudSelect>
    </FilterContent>

    <HeaderContent>
        <MudTh Style="width: 100px;"></MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Display order</MudTh>
        <MudTh>Created</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>
            <MudImage Src="@(context.ImageUrl ?? "images/image-placeholder.svg")"
                      Alt="Category image"
                      Width="36"
                      Height="36"
                      Class="d-block ml-auto"/>
        </MudTd>

        <MudTd DataLabel="Name">
            @context.Name
        </MudTd>

        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Variant="Variant.Text"
                     Color="@(context.Status is CategoryStatus.Active ? Color.Success : Color.Error)">
                @context.Status.ToString()
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Display order">
            @context.DisplayOrder
        </MudTd>

        <MudTd DataLabel="Created">
            @context.CreatedAtUtc.ToDisplayDateTime(TimeZoneService.TimeZone)
        </MudTd>
    </RowTemplate>
</DataTable>