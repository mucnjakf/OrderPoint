<HighlightCard Label="@Label"
               Icon="@Icon"
               Color="@Color"
               IsLoading="@IsLoading"
               ShowContent="@(Item is not null)"
               EmptyText="@EmptyText"
               OnClick="@OnCardClickAsync">
    @if (Item is not null)
    {
        <MudImage Src="@(Item.ImageUrl ?? "images/image-placeholder.svg")"
                  Alt="Item image"
                  Class="mb-3"
                  Width="55"
                  Height="55"
                  ObjectFit="ObjectFit.Cover"/>

        <MudText Typo="Typo.body1" Align="Align.Center">
            @Item.Name
        </MudText>

        <MudText Typo="Typo.caption" Class="mb-2">
            @Item.Category.Name
        </MudText>

        <MudText Typo="Typo.h6">
            @Item.Price.ToString("C", CultureInfo.CurrentCulture)
        </MudText>

        @if (Caption is not null)
        {
            <MudText Typo="Typo.caption" Class="mt-1">
                @Caption
            </MudText>
        }
    }
</HighlightCard>