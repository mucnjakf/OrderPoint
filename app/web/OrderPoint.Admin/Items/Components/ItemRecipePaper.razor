<MudPaper Class="pa-5 mb-5">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small"/>

        <MudText Typo="Typo.subtitle1" Class="flex-1">
            Recipe
        </MudText>

        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@(Recipe is null)"
                   OnClick="@OnEditClick">
            Edit recipe
        </MudButton>
    </MudStack>

    <StatefulView IsLoading="@(Recipe is null)"
                  ShowContent="@(Recipe?.Lines.Count > 0)"
                  Compact="true"
                  EmptyStateIcon="@Icons.Material.Filled.Science"
                  EmptyStateText="No recipe yet"
                  EmptyStateDetail="Stock isn't tracked for this item until it has one.">
        <LoadingContent>
            <ItemRecipePaperSkeleton/>
        </LoadingContent>

        <ChildContent>
            <MudStack Spacing="2">
                @foreach (RecipeLineDto line in Recipe!.Lines)
                {
                    <MudStack @key="@line.StockItemId" Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@line.Group.GetIcon()"
                                 Size="Size.Small"
                                 Style="color: var(--mud-palette-text-secondary)"/>

                        <MudText Typo="Typo.body2" Class="flex-1">
                            @line.StockItemName
                        </MudText>

                        @if (!line.HasServing)
                        {
                            <MudChip T="string"
                                     Variant="Variant.Text"
                                     Size="Size.Small"
                                     Color="Color.Warning"
                                     Class="ma-0">
                                Ran short
                            </MudChip>
                        }

                        <MudText Typo="Typo.body2" Style="width: 110px; text-align: right">
                            @line.Unit.FormatAmount(line.Quantity)
                        </MudText>

                        <MudText Typo="Typo.body2" Style="@CostStyle">
                            @line.Cost.ToString("C", CultureInfo.CurrentCulture)
                        </MudText>
                    </MudStack>
                }

                <MudDivider Class="my-1"/>

                <MudText Typo="Typo.body2" Align="Align.Right">
                    @MarginText
                </MudText>
            </MudStack>
        </ChildContent>
    </StatefulView>
</MudPaper>