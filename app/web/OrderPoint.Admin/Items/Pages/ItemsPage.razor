@page "/items"

<PageTitle>Items</PageTitle>

<PageHeader Text="Items" Breadcrumbs="@Breadcrumbs"/>

<MudStack Row="true" Spacing="3" Class="mb-5">
    <ItemSpotlightCard Label="Newest"
                       Icon="@Icons.Material.Filled.AutoAwesome"
                       Color="Color.Info"
                       Item="@NewestItem"
                       IsLoading="@IsLoadingNewestItem"
                       Caption="@NewestItemCaption"
                       EmptyText="No items yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>

    <ItemSpotlightCard Label="Last edited"
                       Icon="@Icons.Material.Filled.Edit"
                       Color="Color.Secondary"
                       Item="@LastEditedItem"
                       IsLoading="@IsLoadingLastEditedItem"
                       Caption="@LastEditedItemCaption"
                       EmptyText="No edits yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>

    <ItemSpotlightCard Label="Highest price"
                       Icon="@Icons.Material.Filled.TrendingUp"
                       Color="Color.Warning"
                       Item="@HighestPriceItem"
                       IsLoading="@IsLoadingHighestPriceItem"
                       EmptyText="No items yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>

    <ItemSpotlightCard Label="Lowest price"
                       Icon="@Icons.Material.Filled.TrendingDown"
                       Color="Color.Success"
                       Item="@LowestPriceItem"
                       IsLoading="@IsLoadingLowestPriceItem"
                       EmptyText="No items yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>
</MudStack>

<DataGrid TItem="ItemDto"
          Items="@Items"
          Pagination="@Pagination"
          IsLoading="@IsLoading"
          SearchLabel="Search by name"
          SearchQuery="@SearchQuery"
          SearchQueryChanged="@(value => SearchQuery = value)"
          SelectedSortBy="@SelectedSortBy"
          SelectedSortByChanged="@(value => SelectedSortBy = value)"
          OnSearchChanged="@OnSearchChangedAsync"
          OnSortChanged="@OnSortChangedAsync"
          OnPageChanged="@OnPageChangedAsync"
          SortByOptions="@Enum.GetNames(typeof(ItemSortBy))"
          GetSortByLabel="@ItemSorting.GetSortByLabel"
          GetSortByIcon="@ItemSorting.GetSortByIcon"
          CreateButtonText="New item"
          OnCreateClick="@ShowCreateItemDialogAsync"
          OnDetailsClick="@ShowItemDetailsDialogAsync"
          OnUpdateClick="@ShowUpdateItemDialogAsync"
          OnDeleteClick="@(item => ShowDeleteItemDialogAsync(item.Id, item.Name))"
          DeleteButtonDisabled="@(item => item.OrdersCount > 0)"
          DeleteButtonDisabledTooltipText="Item has orders"
          EmptyStateIcon="@Icons.Material.Filled.MenuBook"
          EmptyStateText="No items found">

    <FilterContent>
        <MudAutocomplete @bind-Value="@SelectedCategory"
                         @bind-Value:after="@OnCategoryChangedAsync"
                         T="CategoryDto"
                         SearchFunc="@OnCategorySearchAsync"
                         Variant="Variant.Outlined"
                         Label="Filter by category"
                         Clearable="true"
                         ShowProgressIndicator="true"
                         Class="mt-0"
                         ToStringFunc="@(category => category?.Name)">
            <NoItemsTemplate>
                <MudText Align="Align.Center" Class="px-3 py-1">
                    No categories found
                </MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
    </FilterContent>

    <RowTemplate>
        <ItemCardImage ImageUrl="@context.ImageUrl"/>

        <MudCardContent>
            <MudStack Row="true" Class="mb-2 d-flex justify-space-between">
                <MudText Typo="Typo.h6">
                    @context.Name
                </MudText>

                <MudText Typo="Typo.h6">
                    @context.Price.ToString("C", CultureInfo.CurrentCulture)
                </MudText>
            </MudStack>

            <MudText Typo="Typo.body1" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Circle"
                         Style="width: 6px; height: 6px; margin-right: 3px; vertical-align: center;"/>

                @context.Category.Name
            </MudText>

            <MudText Typo="Typo.body2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Circle"
                         Style="width: 6px; height: 6px; margin-right: 3px; vertical-align: center;"/>

                @context.Description
            </MudText>

            <MudText Typo="Typo.body2">
                <MudIcon Icon="@Icons.Material.Filled.Circle"
                         Style="width: 6px; height: 6px; margin-right: 3px; vertical-align: center;"/>

                @context.CreatedAtUtc.ToDisplayDateTime(TimeZoneService.TimeZone)
            </MudText>
        </MudCardContent>
    </RowTemplate>
</DataGrid>