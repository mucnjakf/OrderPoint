@page "/items"

<PageTitle>Items</PageTitle>

<PageHeader Text="Items"/>

<MudStack Row="true" Spacing="3" Class="mb-5">
    <ItemSpotlightCard Label="Newest"
                       Icon="@Icons.Material.Filled.AutoAwesome"
                       Color="Color.Info"
                       Item="@NewestItem"
                       IsLoading="@IsLoadingNewestItem"
                       Caption="@NewestItemCaption"
                       EmptyText="No items yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>

    <ItemSpotlightCard Label="Last edited"
                       Icon="@Icons.Material.Filled.Edit"
                       Color="Color.Secondary"
                       Item="@LastEditedItem"
                       IsLoading="@IsLoadingLastEditedItem"
                       Caption="@LastEditedItemCaption"
                       EmptyText="No edits yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>

    <ItemSpotlightCard Label="Highest price"
                       Icon="@Icons.Material.Filled.TrendingUp"
                       Color="Color.Warning"
                       Item="@HighestPriceItem"
                       IsLoading="@IsLoadingHighestPriceItem"
                       EmptyText="No items yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>

    <ItemSpotlightCard Label="Lowest price"
                       Icon="@Icons.Material.Filled.TrendingDown"
                       Color="Color.Success"
                       Item="@LowestPriceItem"
                       IsLoading="@IsLoadingLowestPriceItem"
                       EmptyText="No items yet"
                       OnClick="@ShowItemDetailsDialogAsync"/>
</MudStack>

<DataGrid TItem="ItemDto"
          Items="@Items"
          Pagination="@Pagination"
          IsLoading="@IsLoading"
          SearchLabel="Search by name"
          SearchQuery="@SearchQuery"
          SearchQueryChanged="@(value => SearchQuery = value)"
          SelectedSortBy="@SelectedSortBy"
          SelectedSortByChanged="@(value => SelectedSortBy = value)"
          OnSearchChanged="@OnSearchChangedAsync"
          OnSortChanged="@OnSortChangedAsync"
          OnPageChanged="@OnPageChangedAsync"
          SortByOptions="@ItemSorting.SortByOptions"
          GetSortByLabel="@ItemSorting.GetSortByLabel"
          GetSortByIcon="@ItemSorting.GetSortByIcon"
          CreateButtonText="New item"
          OnCreateClick="@ShowCreateItemDialogAsync"
          OnDetailsClick="@ShowItemDetailsDialogAsync"
          OnUpdateClick="@ShowUpdateItemDialogAsync"
          OnDeleteClick="@ShowDeleteItemDialogAsync"
          DeleteButtonDisabled="@(item => item.OrdersCount > 0)"
          DeleteButtonDisabledTooltipText="Item has orders"
          @bind-SelectedItems="@SelectedItems"
          EmptyStateIcon="@Icons.Material.Filled.MenuBook"
          EmptyStateText="No items found">

    <LoadingTemplate>
        <ItemCardContentSkeleton/>
    </LoadingTemplate>

    <BulkActionsTemplate>
        <MudButton Variant="Variant.Text"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.CheckCircle"
                   OnClick="@(() => ShowChangeItemsStatusDialogAsync(ItemStatus.Active))">
            Activate
        </MudButton>

        <MudButton Variant="Variant.Text"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Block"
                   OnClick="@(() => ShowChangeItemsStatusDialogAsync(ItemStatus.Inactive))">
            Deactivate
        </MudButton>

        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.DriveFileMove"
                   OnClick="@ShowChangeItemsCategoryDialogAsync">
            Move
        </MudButton>

        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Sell"
                   OnClick="@ShowAdjustItemsPriceDialogAsync">
            Adjust price
        </MudButton>

        <MudTooltip Text="@DeleteSelectedTooltipText">
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@IsDeleteSelectedBlocked"
                       OnClick="@ShowDeleteItemsDialogAsync">
                Delete
            </MudButton>
        </MudTooltip>
    </BulkActionsTemplate>

    <FilterContent>
        <MudSelect @bind-Value="@SelectedStatus"
                   @bind-Value:after="@OnStatusChangedAsync"
                   T="ItemStatus?"
                   Variant="Variant.Outlined"
                   Label="Status"
                   Class="mt-0"
                   FitContent="true">

            <MudSelectItem Value="@(null)" T="ItemStatus?">
                <MudText>All</MudText>
            </MudSelectItem>

            @foreach (ItemStatus status in Enum.GetValues<ItemStatus>())
            {
                <MudSelectItem Value="@status" T="ItemStatus?">
                    <MudText>
                        @status.ToString()
                    </MudText>
                </MudSelectItem>
            }
        </MudSelect>

        <MudAutocomplete @ref="@CategoryAutocomplete"
                         @bind-Value="@SelectedCategory"
                         @bind-Value:after="@OnCategoryChangedAsync"
                         T="CategoryDto"
                         SearchFunc="@OnCategorySearchAsync"
                         Variant="Variant.Outlined"
                         Label="Filter by category"
                         Clearable="true"
                         OnClearButtonClick="@OnCategoryClearedAsync"
                         ShowProgressIndicator="true"
                         Class="mt-0"
                         ToStringFunc="@(category => category?.Name)">
            <ItemTemplate Context="category">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudImage Src="@(category.ImageUrl ?? ImageUrls.Placeholder)"
                              Alt="Category image"
                              Width="24"
                              Height="24"
                              ObjectFit="ObjectFit.Cover"/>

                    <MudText Typo="Typo.body1">
                        @category.Name
                    </MudText>
                </MudStack>
            </ItemTemplate>

            <NoItemsTemplate>
                <MudText Align="Align.Center" Class="px-3 py-1">
                    No categories found
                </MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
    </FilterContent>

    <RowTemplate>
        <ItemCardContent ImageUrl="@context.ImageUrl"
                         IsActive="@context.IsActive"
                         CategoryName="@context.Category.Name"
                         CategoryImageUrl="@context.Category.ImageUrl"
                         Name="@context.Name"
                         Description="@context.Description"
                         Price="@context.Price"
                         Portion="@context.Portion"
                         OrdersCount="@context.OrdersCount"/>
    </RowTemplate>
</DataGrid>