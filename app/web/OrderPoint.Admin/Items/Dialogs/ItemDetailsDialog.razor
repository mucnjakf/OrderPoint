<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook"/>
            <MudText Typo="Typo.h6">Item details</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3" Class="mb-5">
            <MudItem xs="12" md="4">
                <ItemPreviewPaper ImageUrl="@Item.ImageUrl"
                                  Name="@Item.Name"
                                  Description="@Item.Description"
                                  Price="@Item.Price"/>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-5" Style="height: 100%">
                    <TextDisplayRow Icon="@Icons.Material.Filled.Numbers"
                                    Label="ID"
                                    Text="@Item.Id.ToString()"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.ShortText"
                                    Label="Name"
                                    Text="@Item.Name"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Description"
                                    Label="Description"
                                    Text="@Item.Description"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.LocalDrink"
                                    Label="Portion"
                                    Text="@Item.Portion.ToString(CultureInfo.CurrentCulture)"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.AttachMoney"
                                    Label="Price"
                                    Text="@Item.Price.ToString("C", CultureInfo.CurrentCulture)"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Category"
                                    Label="Category"
                                    Text="@Item.Category.Name"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                    Label="Created"
                                    Text="@Item.CreatedAtUtc.ToString("G")"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                    Label="Updated"
                                    Text="@(Item.UpdatedAtUtc?.ToString("G") ?? "-")"/>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <DataList TItem="OrderDto"
                  Items="@Orders"
                  Pagination="@Pagination"
                  IsLoading="@IsLoading"
                  SelectedSortBy="@SelectedSortBy"
                  SelectedSortByChanged="@(value => SelectedSortBy = value)"
                  SearchLabel="Search by table or number"
                  SearchQuery="@SearchQuery"
                  SearchQueryChanged="@(value => SearchQuery = value)"
                  OnSearchChanged="@OnSearchChangedAsync"
                  OnSortChanged="@OnSortChangedAsync"
                  OnPageChanged="@OnPageChangedAsync"
                  SortByOptions="@Enum.GetNames(typeof(OrderSortBy))"
                  GetSortByLabel="@OrderSorting.GetSortByLabel"
                  GetSortByIcon="@OrderSorting.GetSortByIcon"
                  EmptyStateIcon="@Icons.Material.Filled.Receipt"
                  EmptyStateText="No orders found">

            <RowTemplate>
                @{
                    OrderItemDto orderItem = GetOrderItem(context);
                }

                <MudStack Row="true" Class="d-flex justify-space-between">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body1">
                            #@context.Number · @context.TableCode
                        </MudText>

                        <MudText Typo="Typo.caption">
                            @context.CreatedAtUtc.ToString("G")
                        </MudText>
                    </MudStack>

                    <MudStack Row="true" Class="align-center">
                        <MudChip T="string"
                                 Variant="Variant.Text"
                                 Color="@context.Status.GetColor()">
                            @context.Status.ToString()
                        </MudChip>

                        <MudDivider Vertical="true"/>

                        <MudStack Spacing="1" Class="align-end">
                            <MudText Typo="Typo.body1">
                                @orderItem.Quantity x @orderItem.UnitPrice.ToString("C", CultureInfo.CurrentCulture)
                            </MudText>

                            <MudText Typo="Typo.caption">
                                Order total @context.Total.ToString("C", CultureInfo.CurrentCulture)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>
            </RowTemplate>
        </DataList>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   OnClick="@Close"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>