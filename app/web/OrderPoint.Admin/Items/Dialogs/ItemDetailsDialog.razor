<MudDialog ActionsClass="pa-6">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook"/>
            <MudText Typo="Typo.h6">Item details</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3" Class="mb-5">
            <MudItem xs="12" md="4">
                <ItemPreviewPaper ImageUrl="@Item.ImageUrl"
                                  Name="@Item.Name"
                                  Description="@Item.Description"
                                  Price="@Item.Price"/>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-5" Style="height: 100%">
                    <TextDisplayRow Icon="@Icons.Material.Filled.Numbers"
                                    Label="ID"
                                    Text="@Item.Id.ToString()"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.ShortText"
                                    Label="Name"
                                    Text="@Item.Name"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Description"
                                    Label="Description"
                                    Text="@Item.Description"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.LocalDrink"
                                    Label="Portion"
                                    Text="@Item.Portion.ToString(CultureInfo.CurrentCulture)"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.AttachMoney"
                                    Label="Price"
                                    Text="@Item.Price.ToString("C", CultureInfo.CurrentCulture)"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Category"
                                    Label="Category"
                                    Text="@Item.Category.Name"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                    Label="Created"
                                    Text="@Item.CreatedAtUtc.ToString("G")"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                    Label="Updated"
                                    Text="@(Item.UpdatedAtUtc.HasValue ? Item.UpdatedAtUtc.Value.ToString("G") : "-")"/>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* TODO: add orders list *@
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   OnClick="Close"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>



