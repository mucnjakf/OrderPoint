<EditForm Model="@Request" OnValidSubmit="@OnValidSubmit" OnInvalidSubmit="@OnInvalidSubmit">
    <DataAnnotationsValidator/>

    <MudDialog ActionsClass="pa-6" Class="mud-background">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook"/>
                <MudText Typo="Typo.h6">Edit item</MudText>
            </MudStack>
        </TitleContent>

        <DialogContent>
            <MudGrid>
                <MudItem md="8">
                    <MudTextField Label="Name"
                                  @bind-Value="@Request.Name"
                                  For="@(() => Request.Name)"
                                  Class="mb-5 mt-0"
                                  HelperText="The display name of the item shown to customers."
                                  Variant="Variant.Outlined"
                                  Immediate="true"/>

                    <MudTextField Label="Description"
                                  @bind-Value="@Request.Description"
                                  For="@(() => Request.Description)"
                                  HelperText="A brief description of the item and its ingredients."
                                  Variant="Variant.Outlined"
                                  Class="mb-5"
                                  Lines="5"
                                  Immediate="true"/>

                    <MudStack Row="true">
                        <MudNumericField Label="Portion"
                                         @bind-Value="@Request.Portion"
                                         For="@(() => Request.Portion)"
                                         HelperText="Serving size."
                                         Variant="Variant.Outlined"
                                         Class="mb-5 flex-1"
                                         Style="min-width: 0"
                                         Immediate="true"/>

                        <MudSelect Label="Status"
                                   T="ItemStatus"
                                   @bind-Value="@Request.Status"
                                   For="@(() => Request.Status)"
                                   HelperText="Inactive items can't be ordered."
                                   Variant="Variant.Outlined"
                                   Class="mb-5 flex-1"
                                   Style="min-width: 0">
                            @foreach (ItemStatus status in Enum.GetValues<ItemStatus>())
                            {
                                <MudSelectItem Value="@status" T="ItemStatus">
                                    <MudText>
                                        @status.ToString()
                                    </MudText>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>

                    <MudStack Row="true">
                        <MudSelect @bind-Value="@PriceMode"
                                   @bind-Value:after="@OnPriceModeChanged"
                                   T="PriceAdjustmentMode"
                                   Label="Price"
                                   HelperText="Set it, or change it by % or €."
                                   Variant="Variant.Outlined"
                                   Class="mb-5 flex-1"
                                   Style="min-width: 0">
                            @foreach (PriceAdjustmentMode mode in Enum.GetValues<PriceAdjustmentMode>())
                            {
                                <MudSelectItem Value="@mode">
                                    @mode.GetLabel()
                                </MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField @bind-Value="@PriceValue"
                                         @bind-Value:after="@OnPriceValueChanged"
                                         T="decimal?"
                                         Label="Value"
                                         HelperText="@PriceHelperText"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.End"
                                         AdornmentText="@PriceAdornmentText"
                                         Error="@(PriceErrorText is not null)"
                                         ErrorText="@PriceErrorText"
                                         Class="mb-5 flex-1"
                                         Style="min-width: 0"
                                         Immediate="true"/>
                    </MudStack>

                    <MudGrid Spacing="3">
                        <MudItem xs="6">
                            <MudAutocomplete @ref="@CategoryAutocomplete"
                                             @bind-Value="@SelectedCategory"
                                             @bind-Value:after="@OnSelectedCategoryChanged"
                                             T="CategoryDto"
                                             SearchFunc="@OnCategorySearchAsync"
                                             Variant="Variant.Outlined"
                                             HelperText="The category this item belongs to."
                                             Label="Category"
                                             Clearable="true"
                                             OnClearButtonClick="@OnCategoryClearedAsync"
                                             ShowProgressIndicator="true"
                                             ToStringFunc="@(category => category?.Name)"
                                             Error="@(IsFormSubmitted && Request.CategoryId == Guid.Empty)"
                                             ErrorText="Category is required.">
                                <ItemTemplate Context="category">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudImage Src="@(category.ImageUrl ?? ImageUrls.Placeholder)"
                                                  Alt="Category image"
                                                  Width="24"
                                                  Height="24"
                                                  ObjectFit="ObjectFit.Cover"/>

                                        <MudText Typo="Typo.body1">
                                            @category.Name
                                        </MudText>
                                    </MudStack>
                                </ItemTemplate>

                                <NoItemsTemplate>
                                    <MudText Align="Align.Center" Class="px-3 py-1">
                                        No categories found
                                    </MudText>
                                </NoItemsTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="6">
                            <ImageUploadField FileName="@ImageFileName"
                                              OnImageSelected="@OnImageSelected"
                                              OnImageRemoved="@OnImageRemoved"/>
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudItem md="4">
                    <ItemPreviewPaper ImageUrl="@PreviewImageUrl"
                                      Name="@Request.Name"
                                      Description="@Request.Description"
                                      Portion="@Request.Portion"
                                      Price="@Request.Price"
                                      IsActive="@IsPreviewActive"
                                      NamePlaceholder="Item name"
                                      DescriptionPlaceholder="Item description"/>

                </MudItem>
            </MudGrid>
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
                Cancel
            </MudButton>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit">
                Confirm
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>