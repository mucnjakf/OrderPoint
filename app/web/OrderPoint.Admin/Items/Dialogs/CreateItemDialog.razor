<EditForm Model="@Request" OnValidSubmit="@OnValidSubmit" OnInvalidSubmit="@OnInvalidSubmit">
    <DataAnnotationsValidator/>

    <MudDialog ActionsClass="pa-6" Class="mud-background">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook"/>
                <MudText Typo="Typo.h6">New item</MudText>
            </MudStack>
        </TitleContent>

        <DialogContent>
            <MudGrid>
                <MudItem md="8">
                    <MudTextField Label="Name"
                                  @bind-Value="@Request.Name"
                                  For="@(() => Request.Name)"
                                  Class="mb-5 mt-0"
                                  HelperText="The display name of the item shown to customers."
                                  Variant="Variant.Outlined"
                                  Immediate="true"/>

                    <MudTextField Label="Description"
                                  @bind-Value="@Request.Description"
                                  For="@(() => Request.Description)"
                                  HelperText="A brief description of the item and its ingredients."
                                  Variant="Variant.Outlined"
                                  Class="mb-5"
                                  Lines="5"
                                  Immediate="true"/>

                    <MudStack Row="true">
                        <MudNumericField Label="Portion"
                                         @bind-Value="@Request.Portion"
                                         For="@(() => Request.Portion)"
                                         HelperText="Serving size."
                                         Variant="Variant.Outlined"
                                         Class="mb-5"
                                         Immediate="true"/>

                        <MudNumericField Label="Price"
                                         @bind-Value="@Request.Price"
                                         For="@(() => Request.Price)"
                                         HelperText="Price in euros."
                                         Variant="Variant.Outlined"
                                         Class="mb-5"
                                         Immediate="true"/>

                        <MudSelect Label="Status"
                                   T="ItemStatus"
                                   @bind-Value="@Request.Status"
                                   For="@(() => Request.Status)"
                                   HelperText="Inactive items, or items in an inactive category, can't be ordered."
                                   Variant="Variant.Outlined"
                                   Class="mb-5">
                            @foreach (ItemStatus status in Enum.GetValues<ItemStatus>())
                            {
                                <MudSelectItem Value="@status" T="ItemStatus">
                                    <MudText>
                                        @status.ToString()
                                    </MudText>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                    <MudGrid Spacing="3">
                        <MudItem xs="6">
                            <MudAutocomplete @bind-Value="@SelectedCategory"
                                             @bind-Value:after="@OnSelectedCategoryChanged"
                                             T="CategoryDto"
                                             SearchFunc="@OnCategorySearchAsync"
                                             Variant="Variant.Outlined"
                                             HelperText="The category this item belongs to."
                                             Label="Category"
                                             Clearable="true"
                                             ShowProgressIndicator="true"
                                             ToStringFunc="@(category => category?.Name)"
                                             Error="@(IsFormSubmitted && Request.CategoryId == Guid.Empty)"
                                             ErrorText="Category is required."
                                             Disabled="@(Category is not null)">
                                <NoItemsTemplate>
                                    <MudText Align="Align.Center" Class="px-3 py-1">
                                        No categories found
                                    </MudText>
                                </NoItemsTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="6">
                            <ImageUploadField FileName="@Request.Image?.FileName"
                                              OnImageSelected="@OnImageSelected"
                                              OnImageRemoved="@OnImageRemoved"/>
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudItem md="4">
                    <ItemPreviewPaper ImageUrl="@PreviewImageUrl"
                                      Name="@Request.Name"
                                      Description="@Request.Description"
                                      Price="@Request.Price"
                                      IsActive="@IsPreviewActive"
                                      NamePlaceholder="Item name"
                                      DescriptionPlaceholder="Item description"/>

                </MudItem>
            </MudGrid>
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
                Cancel
            </MudButton>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Confirm
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>