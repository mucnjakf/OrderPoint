@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" @bind-IsDarkMode="@IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider CloseButton="true"
                   BackdropClick="false"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true"/>
<MudSnackbarProvider/>

@* Nothing renders until the session is read from the browser, then the login form replaces any page *@
@if (!AuthService.IsLoaded)
{
    return;
}

@if (!AuthService.IsSignedIn)
{
    <LoginForm/>

    return;
}

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton
            Icon="@Icons.Material.Filled.Menu"
            Color="Color.Inherit"
            Edge="Edge.Start"
            OnClick="@ToggleDrawer"/>

        <MudStack Class="ml-3" Row="true" AlignItems="AlignItems.Center">
            <MudImage Src="images/orderpoint-logo.svg" Alt="OrderPoint logo" Width="36" Height="36"/>

            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">OrderPoint</MudText>
                <MudText Typo="Typo.caption">Admin web</MudText>
            </MudStack>
        </MudStack>

        <MudSpacer/>

        <MudTooltip Text="@(IsDarkMode ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@DarkModeIcon" OnClick="@ToggleDarkMode" Color="Color.Inherit"/>
        </MudTooltip>

        <MudText Typo="Typo.body2" Class="ml-3 mr-1">@AuthService.Email</MudText>

        <MudTooltip Text="Sign out">
            <MudIconButton Icon="@Icons.Material.Filled.Logout" OnClick="@SignOutAsync" Color="Color.Inherit"/>
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="@DrawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Mini">
        <MudNavMenu Bordered="true">
            @if (DrawerOpen)
            {
                <MudText Typo="Typo.button" HtmlTag="p" Class="px-3 pt-3 pb-1" Style="font-size: 12px">
                    Overview
                </MudText>
            }

            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                <MudText Typo="Typo.body1">Dashboard</MudText>
            </MudNavLink>

            <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
                <MudText Typo="Typo.body1">Orders</MudText>
            </MudNavLink>

            <MudDivider Class="my-3"/>

            @if (DrawerOpen)
            {
                <MudText Typo="Typo.button" HtmlTag="p" Class="px-3 pt-1 pb-1" Style="font-size: 12px">
                    Management
                </MudText>
            }

            <MudNavLink Href="/bartenders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                <MudText Typo="Typo.body1">Bartenders</MudText>
            </MudNavLink>

            <MudNavLink Href="/items" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">
                <MudText Typo="Typo.body1">Items</MudText>
            </MudNavLink>

            <MudNavLink Href="/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">
                <MudText Typo="Typo.body1">Categories</MudText>
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="pa-3">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>