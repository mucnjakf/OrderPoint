@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" @bind-IsDarkMode="@IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" BackdropClick="false" Position="DialogPosition.Center" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

@if (!AuthService.IsLoaded)
{
    return;
}

@if (!AuthService.IsSignedIn)
{
    <LoginForm />

    return;
}

<MudLayout>
    <MudAppBar Elevation="0" Style="border-bottom: 1px solid var(--mud-palette-lines-default)">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudImage Src="images/orderpoint-logo.svg" Alt="OrderPoint logo" Width="36" Height="36" />

            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Style="line-height: 1.2">OrderPoint</MudText>
                <MudText Typo="Typo.caption" Style="line-height: 1.2">Admin web</MudText>
            </MudStack>
        </MudStack>

        <MudSpacer />

        <SearchTrigger OnClick="@OpenSearchAsync" />

        <MudTooltip Text="@(IsDarkMode ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@DarkModeIcon" OnClick="@ToggleDarkModeAsync" Color="Color.Inherit" />
        </MudTooltip>

        <HealthStatusIndicator />
    </MudAppBar>

    <MudDrawer @bind-Open="@DrawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Mini"
               Style="border-right: 1px solid var(--mud-palette-lines-default)">
        <MudNavMenu Bordered="true">
            @if (DrawerOpen)
            {
                <MudText Typo="Typo.button" HtmlTag="p" Class="px-3 pt-3 pb-1" Style="font-size: 12px">
                    Overview
                </MudText>
            }

            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                <MudText Typo="Typo.body1">Dashboard</MudText>
            </MudNavLink>

            <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
                <MudText Typo="Typo.body1">Orders</MudText>
            </MudNavLink>

            <MudDivider Class="my-3" />

            @if (DrawerOpen)
            {
                <MudText Typo="Typo.button" HtmlTag="p" Class="px-3 pt-1 pb-1" Style="font-size: 12px">
                    Management
                </MudText>
            }

            <MudNavLink Href="/bartenders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                <MudText Typo="Typo.body1">Bartenders</MudText>
            </MudNavLink>

            <MudNavLink Href="/items" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">
                <MudText Typo="Typo.body1">Items</MudText>
            </MudNavLink>

            <MudNavLink Href="/categories" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">
                <MudText Typo="Typo.body1">Categories</MudText>
            </MudNavLink>

            <MudDivider Class="my-3" />

            @if (DrawerOpen)
            {
                <MudText Typo="Typo.button" HtmlTag="p" Class="px-3 pt-1 pb-1" Style="font-size: 12px">
                    System
                </MudText>
            }

            <MudNavLink Href="/system" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MonitorHeart">
                <MudText Typo="Typo.body1">Health</MudText>
            </MudNavLink>

            <MudNavLink Href="/account" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
                <MudText Typo="Typo.body1">Account</MudText>
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <div style="@DrawerToggleWrapperStyle">
        <MudTooltip Text="@(DrawerOpen ? "Collapse menu" : "Expand menu")" Placement="Placement.Right">
            <MudIconButton Icon="@DrawerToggleIcon" Size="Size.Small" Class="pa-1" Style="@DrawerToggleButtonStyle"
                           OnClick="@ToggleDrawerAsync" />
        </MudTooltip>
    </div>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="pa-3">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>