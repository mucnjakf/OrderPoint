@* Blazor shows this instead of its built-in dialog, which ignores the theme *@
<script type="module" src="@Assets["Shared/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="reconnect-content">
        <div class="reconnect-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>

        <p class="reconnect-first-attempt">
            Rejoining the server...
        </p>

        <p class="reconnect-repeated-attempt">
            Rejoin failed. Trying again in <span id="components-seconds-to-next-attempt"></span> s...
        </p>

        <p class="reconnect-failed">
            Could not rejoin the server.<br/>Retry or reload the page.
        </p>

        <button id="components-reconnect-button" class="reconnect-failed">
            Retry
        </button>

        <p class="reconnect-paused">
            The session has been paused by the server.
        </p>

        <button id="components-resume-button" class="reconnect-paused">
            Resume
        </button>

        <p class="reconnect-resume-failed">
            Could not resume the session.<br/>Please reload the page.
        </p>
    </div>
</dialog>