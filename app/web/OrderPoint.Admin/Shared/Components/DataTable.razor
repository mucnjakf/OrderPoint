@typeparam TItem

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-3">
    <MudStack Row="true">
        <MudTextField @bind-Value="@SearchQuery"
                      @bind-Value:after="@OnSearchChangedAsync"
                      T="string"
                      Label="@SearchLabel"
                      Variant="Variant.Outlined"
                      Clearable="true"
                      DebounceInterval="500"
                      Immediate="false"/>

        <MudSelect @bind-Value="@SelectedSortBy"
                   @bind-Value:after="@OnSortChangedAsync"
                   T="string"
                   Variant="Variant.Outlined"
                   Label="Sort by"
                   FitContent="true">
            @foreach (string sortBy in SortByOptions)
            {
                <MudSelectItem Value="@sortBy">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1">@GetSortByLabel(sortBy)</MudText>
                        <MudIcon Icon="@GetSortByIcon(sortBy)" Size="Size.Small"/>
                    </MudStack>
                </MudSelectItem>
            }
        </MudSelect>

        @if (FilterContent is not null)
        {
            @FilterContent
        }
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center">
        @ToolbarActionsContent

        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   OnClick="@OnCreateClickAsync">
            @CreateButtonText
        </MudButton>
    </MudStack>
</MudStack>

@if (SelectedItems.Count > 0 && BulkActionsTemplate is not null)
{
    <BulkActionBar SelectedCount="@SelectedItems.Count"
                   TotalCount="@Items.Count"
                   OnSelectAllClick="@SelectAllAsync"
                   OnClearClick="@ClearSelectionAsync">
        @BulkActionsTemplate
    </BulkActionBar>
}

@if (IsLoading && LoadingTemplate is not null)
{
    <MudTable T="int" Items="@LoadingRows">
        <HeaderContent>
            @if (IsSelectable)
            {
                <MudTh></MudTh>
            }

            @HeaderContent
            <MudTh Style="width: 150px;"></MudTh>
        </HeaderContent>

        <RowTemplate>
            @if (IsSelectable)
            {
                <MudTd>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="18px" Height="18px"/>
                </MudTd>
            }

            @LoadingTemplate

            <MudTd>
                <MudStack Row="true" Spacing="0">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="30px" Height="30px"/>

                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="30px" Height="30px" Class="mx-2"/>

                    @if (OnDeleteClick.HasDelegate)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="30px" Height="30px"/>
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <StatefulView IsLoading="@IsLoading"
                  ShowContent="@Items.Any()"
                  EmptyStateIcon="@EmptyStateIcon"
                  EmptyStateText="@EmptyStateText">

        <MudTable T="TItem"
                  Items="@Items"
                  Hover="true"
                  MultiSelection="@IsSelectable"
                  SelectOnRowClick="false"
                  SelectedItems="@SelectedItems"
                  SelectedItemsChanged="@OnSelectedItemsChangedAsync">
            <HeaderContent>
                @HeaderContent
                <MudTh Style="width: 150px;"></MudTh>
            </HeaderContent>

            <RowTemplate>
                @RowTemplate(context)

                <MudTd>
                    <MudTooltip Text="Details">
                        <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => OnDetailsClickAsync(context))"/>
                    </MudTooltip>

                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       Class="mx-2"
                                       OnClick="@(() => OnUpdateClickAsync(context))"/>
                    </MudTooltip>

                    @if (OnDeleteClick.HasDelegate)
                    {
                        <MudTooltip Text="@GetDeleteButtonTooltipText(context)">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Disabled="@IsDeleteButtonDisabled(context)"
                                           OnClick="@(() => OnDeleteClickAsync(context))"/>
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (Pagination is not null && Pagination.TotalPages > 1)
        {
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                <MudText Typo="Typo.caption">
                    Showing @((Pagination.PageNumber - 1) * Pagination.PageSize + 1)
                    to @(Math.Min(Pagination.PageNumber * Pagination.PageSize, Pagination.TotalCount))
                    of @Pagination.TotalCount items
                </MudText>

                <MudPagination Count="@Pagination.TotalPages"
                               Selected="@Pagination.PageNumber"
                               SelectedChanged="@OnPageChanged"
                               BoundaryCount="1"
                               MiddleCount="3"
                               ShowFirstButton="true"
                               ShowLastButton="true"/>
            </MudStack>
        }
    </StatefulView>
}