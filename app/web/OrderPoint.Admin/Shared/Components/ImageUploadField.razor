@if (FileName is null)
{
    <MudFileUpload T="IBrowserFile"
                   Accept="@AcceptedFileExtensions"
                   FilesChanged="@OnFileChangedAsync"
                   Class="mud-width-full">
        <CustomContent>
            <div class="cursor-pointer" @onclick="@context.OpenFilePickerAsync">
                <MudTextField T="string"
                              Label="Image"
                              Placeholder="Upload image"
                              ReadOnly="true"
                              HelperText="@HelperText"
                              Error="@(ErrorText is not null)"
                              ErrorText="@ErrorText"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Upload"
                              Style="pointer-events: none;"/>
            </div>
        </CustomContent>

        <SelectedTemplate/>
    </MudFileUpload>
}
else
{
    <MudTextField T="string"
                  Label="Image"
                  Value="@FileName"
                  ReadOnly="true"
                  HelperText="@HelperText"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Delete"
                  AdornmentColor="Color.Error"
                  AdornmentAriaLabel="Remove image"
                  OnAdornmentClick="@OnRemoveClickAsync"/>
}