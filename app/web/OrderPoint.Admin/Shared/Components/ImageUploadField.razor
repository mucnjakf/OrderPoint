<MudStack Spacing="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudFileUpload T="IBrowserFile" Accept="@AcceptedFileExtensions" FilesChanged="@OnFileChangedAsync">
            <CustomContent>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="@context.OpenFilePickerAsync">
                    Upload image
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        @if (CanRemove)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="@OnRemoveClickAsync">
                Remove image
            </MudButton>
        }
    </MudStack>

    <MudText Typo="Typo.caption" Color="@(ErrorText is null ? Color.Default : Color.Error)">
        @(ErrorText ?? "JPEG, PNG or WebP, at most 2 MB.")
    </MudText>
</MudStack>