<MudPaper Outlined="true" Class="px-4 py-2 d-flex align-center" Style="height: 100%;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width: 100%;">
        <MudText Typo="Typo.body2" Class="mr-2">
            @SelectedCount selected
        </MudText>

        <MudDivider Vertical="true" FlexItem="true"/>

        @ChildContent

        <MudSpacer/>

        @if (SelectedCount < TotalCount)
        {
            <MudButton Variant="Variant.Text" OnClick="@OnSelectAllClickAsync">
                Select all @TotalCount
            </MudButton>
        }

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Close" OnClick="@OnClearClickAsync">
            Clear
        </MudButton>
    </MudStack>
</MudPaper>