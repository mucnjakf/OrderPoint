@typeparam TItem

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-3">
    <MudStack Row="true">
        <MudTextField @bind-Value="@SearchQuery"
                      @bind-Value:after="@OnSearchChangedAsync"
                      T="string"
                      Label="@SearchLabel"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Class="mt-0"
                      DebounceInterval="500"
                      Immediate="false"/>

        <MudSelect @bind-Value="@SelectedSortBy"
                   @bind-Value:after="@OnSortChangedAsync"
                   T="string"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Label="Sort by"
                   Class="mt-0"
                   FitContent="true">
            @foreach (string sortBy in SortByOptions)
            {
                <MudSelectItem Value="@sortBy">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1">@GetSortByLabel(sortBy)</MudText>
                        <MudIcon Icon="@GetSortByIcon(sortBy)" Size="Size.Small"/>
                    </MudStack>
                </MudSelectItem>
            }
        </MudSelect>
    </MudStack>

    @if (OnCreateClick.HasDelegate)
    {
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   OnClick="@OnCreateClickAsync">
            @CreateButtonText
        </MudButton>
    }
</MudStack>

<StableHeight IsLoading="@IsLoading" KeepHeight="true" IsFramed="true" Class="pa-3">
    @if (IsLoading && LoadingTemplate is not null)
    {
        <MudList T="string" ReadOnly="true">
            @for (int i = 0; i < LoadingItemsCount; i++)
            {
                <MudListItem>
                    @LoadingTemplate
                </MudListItem>

                if (i < LoadingItemsCount - 1)
                {
                    <MudDivider/>
                }
            }
        </MudList>
    }
    else
    {
        <StatefulView IsLoading="@IsLoading"
                      ShowContent="@Items.Any()"
                      Flat="true"
                      EmptyStateIcon="@EmptyStateIcon"
                      EmptyStateText="@EmptyStateText">
            <MudList T="string" ReadOnly="true">
                @for (int i = 0; i < Items.Count; i++)
                {
                    TItem item = Items[i];

                    <MudListItem>
                        @RowTemplate(item)
                    </MudListItem>

                    if (i < Items.Count - 1)
                    {
                        <MudDivider/>
                    }
                }
            </MudList>
        </StatefulView>
    }
</StableHeight>

<ListPager TItem="TItem" Pagination="@Pagination" IsLoading="@IsLoading" OnPageChanged="@OnPageChanged"/>