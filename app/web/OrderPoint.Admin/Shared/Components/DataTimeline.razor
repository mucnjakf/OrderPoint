@typeparam TItem

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mb-3">
    <MudStack Row="true">
        <MudTextField @bind-Value="@SearchQuery"
                      @bind-Value:after="@OnSearchChangedAsync"
                      T="string"
                      Label="@SearchLabel"
                      Variant="Variant.Outlined"
                      Clearable="true"
                      DebounceInterval="500"
                      Immediate="false"/>

        <MudSelect @bind-Value="@SelectedSortBy"
                   @bind-Value:after="@OnSortChangedAsync"
                   T="string"
                   Variant="Variant.Outlined"
                   Label="Sort by"
                   FitContent="true">
            @foreach (string sortBy in SortByOptions)
            {
                <MudSelectItem Value="@sortBy">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1">@GetSortByLabel(sortBy)</MudText>
                        <MudIcon Icon="@GetSortByIcon(sortBy)" Size="Size.Small"/>
                    </MudStack>
                </MudSelectItem>
            }
        </MudSelect>

        @if (FilterContent is not null)
        {
            @FilterContent
        }
    </MudStack>
</MudStack>

<StableHeight IsLoading="@IsLoading" KeepHeight="@(Pagination?.PageNumber > 1)" IsFramed="true" Class="pa-3">
    @if (IsLoading && LoadingTemplate is not null)
    {
        <MudTimeline TimelineOrientation="TimelineOrientation.Vertical"
                     TimelinePosition="TimelinePosition.Start">
            @for (int i = 0; i < LoadingItemsCount; i++)
            {
                <MudTimelineItem Color="Color.Transparent" Variant="Variant.Filled" Size="Size.Medium" Elevation="0">
                    <ItemDot>
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="38px" Height="38px"/>
                    </ItemDot>

                    <ItemContent>
                        <MudPaper Class="pa-4">
                            @LoadingTemplate
                        </MudPaper>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }
    else
    {
        <StatefulView IsLoading="@IsLoading"
                      ShowContent="@Items.Any()"
                      Flat="true"
                      EmptyStateIcon="@EmptyStateIcon"
                      EmptyStateText="@EmptyStateText">

            <MudTimeline TimelineOrientation="TimelineOrientation.Vertical"
                         TimelinePosition="TimelinePosition.Start">
                @foreach (TItem item in Items)
                {
                    <MudTimelineItem @key="@item"
                                     Color="@GetItemColor(item)"
                                     Variant="Variant.Filled"
                                     Size="Size.Medium"
                                     Elevation="0">
                        <ItemDot>
                            <MudIcon Icon="@GetItemIcon(item)" Size="Size.Small"/>
                        </ItemDot>

                        <ItemContent>
                            <NewItemHighlight IsNew="@IsNew(item)">
                                <MudPaper Class="pa-4 cursor-pointer"
                                          Style="@GetTicketStyle(item)"
                                          @onclick="@(() => OnItemClickAsync(item))"
                                          @onmouseenter="@(() => HoveredItem = item)"
                                          @onmouseleave="@(() => HoveredItem = default)">
                                    @ItemTemplate(item)
                                </MudPaper>
                            </NewItemHighlight>
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        </StatefulView>
    }
</StableHeight>

<ListPager TItem="TItem" Pagination="@Pagination" IsLoading="@IsLoading" OnPageChanged="@OnPageChanged"/>