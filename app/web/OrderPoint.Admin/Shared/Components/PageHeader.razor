@if (Breadcrumbs is not null)
{
    <MudBreadcrumbs Items="@Breadcrumbs" Class="pl-0 pt-0 pb-5" Style="font-size: 14px"/>
}

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@Text</MudText>

    @ChildContent
</MudStack>