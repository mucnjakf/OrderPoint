<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Receipt"/>
            <MudText Typo="Typo.h6">Order details</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudPaper Class="px-5" Style="height: 100%">
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical"
                                 TimelinePosition="TimelinePosition.Start"
                                 Class="pt-0"
                                 Style="height: 100%; justify-content: space-evenly">
                        @foreach ((OrderStatus status, DateTimeOffset? reachedAtUtc) in TimelineSteps)
                        {
                            <MudTimelineItem Class="pb-0"
                                             Color="@(reachedAtUtc is null ? Color.Default : status.GetColor())"
                                             Variant="@(reachedAtUtc is null ? Variant.Outlined : Variant.Filled)"
                                             Size="Size.Medium"
                                             Elevation="0">
                                <ItemDot>
                                    <MudIcon Icon="@status.GetIcon()"
                                             Size="Size.Small"
                                             Style="@(reachedAtUtc is null
                                                          ? "font-size: 1rem; color: var(--mud-palette-text-disabled)"
                                                          : null)"/>
                                </ItemDot>

                                <ItemContent>
                                    <div style="@(reachedAtUtc is null
                                                      ? "color: var(--mud-palette-text-disabled)"
                                                      : null)">
                                        <MudText Typo="Typo.body1">
                                            @status.ToString()
                                        </MudText>

                                        <MudText Typo="Typo.caption">
                                            @(reachedAtUtc?.ToDisplayDateTime(TimeZoneService.TimeZone) ?? "Not yet")
                                        </MudText>
                                    </div>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-5" Style="height: 100%">
                    <TextDisplayRow Icon="@Icons.Material.Filled.Numbers"
                                    Label="ID"
                                    Text="@Order.Id.ToString()"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Tag"
                                    Label="Number"
                                    Text="@($"#{Order.Number}")"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.TableBar"
                                    Label="Table"
                                    Text="@Order.TableCode"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Notes"
                                    Label="Note"
                                    Text="@(Order.Note ?? "-")"
                                    ShowDivider="true"/>

                    <TextDisplayRow Icon="@Icons.Material.Filled.Person"
                                    Label="Bartender">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <BartenderAvatar FirstName="@Order.Bartender?.FirstName"
                                             LastName="@Order.Bartender?.LastName"
                                             ImageUrl="@Order.Bartender?.ImageUrl"
                                             Size="Size.Small"/>

                            <MudText Typo="Typo.body1">
                                @(Order.Bartender is null
                                    ? "Unassigned"
                                    : $"{Order.Bartender.FirstName} {Order.Bartender.LastName}")
                            </MudText>
                        </MudStack>
                    </TextDisplayRow>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-5">
                    <MudSimpleTable Elevation="0">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Qty</th>
                                <th>Unit price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (OrderItemDto orderItem in Order.Items)
                            {
                                <tr>
                                    <td>
                                        <MudStack Row="true" AlignItems="AlignItems.Center">
                                            <MudImage Src="@(orderItem.ImageUrl ?? ImageUrls.Placeholder)"
                                                      Alt="Item image"
                                                      Width="24"
                                                      Height="24"
                                                      ObjectFit="ObjectFit.Cover"/>

                                            <MudText Typo="Typo.body2">
                                                @orderItem.Name
                                            </MudText>
                                        </MudStack>
                                    </td>
                                    <td>@orderItem.Quantity</td>
                                    <td>@orderItem.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</td>
                                    <td>@GetSubtotal(orderItem).ToString("C", CultureInfo.CurrentCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    <MudDivider Class="my-3"/>

                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">Total</MudText>

                        <MudText Typo="Typo.h6">
                            @Order.Total.ToString("C", CultureInfo.CurrentCulture)
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   OnClick="@Close"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>