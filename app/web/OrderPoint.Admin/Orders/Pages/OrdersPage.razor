@page "/orders"

<PageTitle>Orders</PageTitle>

<PageHeader Text="Orders"/>

<OrderStatusPipeline StatusCounts="@StatusCounts"
                     LoadingStatuses="@LoadingStatuses"
                     SelectedStatus="@SelectedStatus"
                     OnStatusClick="@OnStatusClickAsync"/>

<DataTimeline TItem="OrderDto"
              Items="@Orders"
              Pagination="@Pagination"
              IsLoading="@IsLoading"
              SearchLabel="Search by number or table"
              SearchQuery="@SearchQuery"
              SearchQueryChanged="@(value => SearchQuery = value)"
              SelectedSortBy="@SelectedSortBy"
              SelectedSortByChanged="@(value => SelectedSortBy = value)"
              OnSearchChanged="@OnSearchChangedAsync"
              OnSortChanged="@OnSortChangedAsync"
              OnPageChanged="@OnPageChangedAsync"
              SortByOptions="@Enum.GetNames(typeof(OrderSortBy))"
              GetSortByLabel="@OrderSorting.GetSortByLabel"
              GetSortByIcon="@OrderSorting.GetSortByIcon"
              GetItemColor="@(order => order.Status.GetColor())"
              GetItemIcon="@(order => order.Status.GetIcon())"
              OnItemClick="@ShowOrderDetailsDialogAsync"
              IsItemNew="@(order => NewOrders.IsNew(order.Id))"
              EmptyStateIcon="@Icons.Material.Filled.Receipt"
              EmptyStateText="No orders found">

    <LoadingTemplate>
        <OrderTicketSkeleton/>
    </LoadingTemplate>

    <FilterContent>
        <MudAutocomplete @ref="@BartenderAutocomplete"
                         @bind-Value="@SelectedBartender"
                         @bind-Value:after="@OnBartenderChangedAsync"
                         T="BartenderDto"
                         SearchFunc="@OnBartenderSearchAsync"
                         Variant="Variant.Outlined"
                         Label="Filter by bartender"
                         Clearable="true"
                         OnClearButtonClick="@OnBartenderClearedAsync"
                         ShowProgressIndicator="true"
                         ToStringFunc="@(bartender => bartender is null
                                             ? null
                                             : $"{bartender.FirstName} {bartender.LastName}")">
            <ItemTemplate Context="bartender">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <BartenderAvatar FirstName="@bartender.FirstName"
                                     LastName="@bartender.LastName"
                                     ImageUrl="@bartender.ImageUrl"
                                     Size="Size.Small"/>

                    <MudText Typo="Typo.body1">
                        @bartender.FirstName @bartender.LastName
                    </MudText>
                </MudStack>
            </ItemTemplate>

            <NoItemsTemplate>
                <MudText Align="Align.Center" Class="px-3 py-1">
                    No bartenders found
                </MudText>
            </NoItemsTemplate>
        </MudAutocomplete>

        <MudSelect @bind-Value="@SelectedPayment"
                   @bind-Value:after="@OnPaymentChangedAsync"
                   T="OrderPaymentFilter?"
                   Label="Payment"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   FitContent="true">
            @foreach ((OrderPaymentFilter payment, string label) in PaymentOptions)
            {
                <MudSelectItem T="OrderPaymentFilter?" Value="@payment">@label</MudSelectItem>
            }
        </MudSelect>
    </FilterContent>

    <ItemTemplate>
        <MudStack Row="true" Spacing="4">
            <MudStack Spacing="3" Style="flex: 0 0 45%">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <OrderAvatar Number="@context.Number"/>

                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body1">
                            @context.GetPlaceText()
                        </MudText>

                        <MudText Typo="Typo.caption">
                            @context.CreatedAtUtc.ToDisplayDateTime(TimeZoneService.TimeZone)
                            · @context.CreatedAtUtc.ToRelativeTime()
                        </MudText>
                    </MudStack>

                    <MudSpacer/>

                    @if (NewOrders.IsNew(context.Id))
                    {
                        <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary">
                            New
                        </MudChip>
                    }

                    <MudChip T="string"
                             Variant="Variant.Text"
                             Color="@context.Status.GetColor()">
                        @context.Status.ToString()
                    </MudChip>
                </MudStack>

                @if (context.Note is not null)
                {
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                        "@context.Note"
                    </MudText>
                }

                @if (GetEndReason(context) is { } endReason)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@context.Status.GetIcon()"
                                 Size="Size.Small"
                                 Style="color: var(--mud-palette-text-secondary)"/>

                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                            @endReason
                        </MudText>
                    </MudStack>
                }

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.End" Class="mt-auto">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <BartenderAvatar FirstName="@context.Bartender?.FirstName"
                                         LastName="@context.Bartender?.LastName"
                                         ImageUrl="@context.Bartender?.ImageUrl"/>

                        <MudText Typo="Typo.body2">
                            @(context.Bartender is null
                                ? "Unassigned"
                                : $"{context.Bartender.FirstName} {context.Bartender.LastName}")
                        </MudText>
                    </MudStack>

                    <MudStack AlignItems="AlignItems.End" Spacing="1">
                        <MudText Typo="Typo.h6">
                            @context.Total.ToString("C", CultureInfo.CurrentCulture)
                        </MudText>

                        <MudChip T="string"
                                 Variant="Variant.Outlined"
                                 Size="Size.Small"
                                 Color="@context.GetPaymentColor()"
                                 Icon="@context.GetPaymentIcon()"
                                 Class="ma-0">
                            @context.GetPaymentText()
                        </MudChip>
                    </MudStack>
                </MudStack>
            </MudStack>

            <MudDivider Vertical="true" FlexItem="true"/>

            <MudStack Spacing="2" Class="flex-1">
                @foreach (OrderItemDto orderItem in context.Items)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudImage Src="@(orderItem.ImageUrl ?? ImageUrls.Placeholder)"
                                  Alt="Item image"
                                  Width="32"
                                  Height="32"
                                  ObjectFit="ObjectFit.Cover"
                                  Style="@ImageStyles.Rounded"/>

                        <MudText Typo="Typo.body2" Class="flex-1">
                            @orderItem.Quantity× @orderItem.Name
                        </MudText>

                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                            @((orderItem.Quantity * orderItem.UnitPrice).ToString("C", CultureInfo.CurrentCulture))
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        </MudStack>
    </ItemTemplate>
</DataTimeline>