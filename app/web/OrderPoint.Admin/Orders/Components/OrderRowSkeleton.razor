<MudStack Row="true" Class="d-flex justify-space-between">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                     Width="72px"
                     Height="48px"
                     Style="border-radius: var(--mud-default-borderradius);"/>

        <MudStack Spacing="1">
            <MudText Typo="Typo.body1">
                <MudSkeleton Width="90px"/>
            </MudText>

            <MudText Typo="Typo.caption">
                <MudSkeleton Width="100px"/>
            </MudText>
        </MudStack>
    </MudStack>

    <MudStack Row="true" Class="align-center">
        <ChipSkeleton Width="90px"/>

        <MudDivider Vertical="true"/>

        <MudStack Spacing="1" Class="align-end">
            <MudText Typo="Typo.body1">
                <MudSkeleton Width="70px"/>
            </MudText>

            <MudText Typo="Typo.caption">
                <MudSkeleton Width="50px"/>
            </MudText>
        </MudStack>
    </MudStack>
</MudStack>