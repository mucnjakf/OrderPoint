<HighlightCard Label="@Status.ToString()"
               Icon="@Status.GetIcon()"
               Color="@Status.GetColor()"
               IsLoading="@IsLoading"
               ShowContent="true"
               Height="@CardHeight"
               IsSelected="@IsSelected"
               OnClick="@OnCardClickAsync">
    <LoadingContent>
        <OrderStatusCardSkeleton/>
    </LoadingContent>

    <ChildContent>
        <MudText Typo="Typo.h4">
            <RollingNumber Value="@Count" Text="@Count.ToString()"/>
        </MudText>

        <MudText Typo="Typo.caption">
            @(Count == 1 ? "order" : "orders")
        </MudText>
    </ChildContent>
</HighlightCard>