<div style="@PaymentRowLayout.GridStyle">
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="40px" Height="40px"/>

    <MudStack Spacing="0">
        <MudText Typo="Typo.body1">
            <MudSkeleton Width="60%"/>
        </MudText>

        <MudText Typo="Typo.caption">
            <MudSkeleton Width="45%"/>
        </MudText>
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px"/>

        <MudText Typo="Typo.body2" Class="flex-1">
            <MudSkeleton Width="70%"/>
        </MudText>
    </MudStack>

    <ChipSkeleton/>

    <MudText Typo="Typo.h6">
        <MudSkeleton Width="70px" Class="ml-auto"/>
    </MudText>
</div>