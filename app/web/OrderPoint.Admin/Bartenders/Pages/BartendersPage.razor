@page "/bartenders"

<PageTitle>Bartenders</PageTitle>

<PageHeader Text="Bartenders" Breadcrumbs="@Breadcrumbs"/>

<BartenderTeamStrip ActiveBartenders="@ActiveBartenders"
                    ActiveCount="@ActiveCount"
                    InactiveCount="@InactiveCount"
                    NewestBartender="@NewestBartender"
                    IsLoadingActiveTeam="@IsLoadingActiveTeam"
                    IsLoadingInactiveCount="@IsLoadingInactiveCount"
                    IsLoadingNewestBartender="@IsLoadingNewestBartender"/>

<DataAccordion TItem="BartenderDto"
               Items="@Bartenders"
               Pagination="@Pagination"
               IsLoading="@IsLoading"
               SearchLabel="Search by name"
               SearchQuery="@SearchQuery"
               SearchQueryChanged="@(value => SearchQuery = value)"
               SelectedSortBy="@SelectedSortBy"
               SelectedSortByChanged="@(value => SelectedSortBy = value)"
               OnSearchChanged="@OnSearchChangedAsync"
               OnSortChanged="@OnSortChangedAsync"
               OnPageChanged="@OnPageChangedAsync"
               SortByOptions="@Enum.GetNames(typeof(BartenderSortBy))"
               GetSortByLabel="@BartenderSorting.GetSortByLabel"
               GetSortByIcon="@BartenderSorting.GetSortByIcon"
               CreateButtonText="New bartender"
               OnCreateClick="@ShowCreateBartenderDialogAsync"
               OnUpdateClick="@ShowUpdateBartenderDialogAsync"
               OnDeleteClick="@ShowDeleteBartenderDialogAsync"
               DeleteButtonDisabled="@(bartender => bartender.OrdersCount > 0)"
               DeleteButtonDisabledTooltipText="Bartender has orders"
               EmptyStateIcon="@Icons.Material.Filled.People"
               EmptyStateText="No bartenders found">

    <FilterContent>
        <MudSelect @bind-Value="@SelectedStatus"
                   @bind-Value:after="@OnStatusChangedAsync"
                   T="BartenderStatus?"
                   Variant="Variant.Outlined"
                   Label="Status"
                   FitContent="true">

            <MudSelectItem Value="@(null)" T="BartenderStatus?">
                <MudText>All</MudText>
            </MudSelectItem>

            @foreach (BartenderStatus status in Enum.GetValues<BartenderStatus>())
            {
                <MudSelectItem Value="@status" T="BartenderStatus?">
                    <MudText>
                        @status.ToString()
                    </MudText>
                </MudSelectItem>
            }
        </MudSelect>
    </FilterContent>

    <HeaderTemplate>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-1">
            <BartenderAvatar FirstName="@context.FirstName"
                             LastName="@context.LastName"
                             ImageUrl="@context.ImageUrl"/>

            <MudStack Spacing="0">
                <MudText Typo="Typo.body1">
                    @context.FirstName @context.LastName
                </MudText>

                <MudText Typo="Typo.caption">
                    @context.Email
                </MudText>
            </MudStack>

            <MudSpacer/>

            <MudChip T="string"
                     Variant="Variant.Text"
                     Color="@(context.Status is BartenderStatus.Active ? Color.Success : Color.Error)">
                @context.Status.ToString()
            </MudChip>
        </MudStack>
    </HeaderTemplate>

    <ActionsTemplate>
        <MudTooltip Text="Reset password">
            <MudIconButton Icon="@Icons.Material.Filled.LockReset"
                           Color="Color.Warning"
                           Size="Size.Small"
                           OnClick="@(() => ShowResetBartenderPasswordDialogAsync(context))"/>
        </MudTooltip>
    </ActionsTemplate>

    <DetailsTemplate>
        <MudStack Row="true" Spacing="6">
            <div style="flex: 0 0 40%">
                <TextDisplayRow Icon="@Icons.Material.Filled.Numbers"
                                Label="ID"
                                Text="@context.Id.ToString()"
                                ShowDivider="true"/>

                <TextDisplayRow Icon="@Icons.Material.Filled.Phone"
                                Label="Phone"
                                Text="@(context.PhoneNumber ?? "-")"
                                ShowDivider="true"/>

                <TextDisplayRow Icon="@Icons.Material.Filled.Notes"
                                Label="Notes"
                                Text="@(context.Notes ?? "-")"
                                ShowDivider="true"/>

                <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                Label="Created"
                                Text="@context.CreatedAtUtc.ToDisplayDateTime(TimeZoneService.TimeZone)"
                                ShowDivider="true"/>

                <TextDisplayRow Icon="@Icons.Material.Filled.CalendarMonth"
                                Label="Updated"
                                Text="@(context.UpdatedAtUtc?.ToDisplayDateTime(TimeZoneService.TimeZone) ?? "-")"/>
            </div>

            <div class="flex-1">
                <BartenderOrdersList BartenderId="@context.Id" ShowControls="false"/>

                @if (context.OrdersCount > 0)
                {
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                        <MudButton Variant="Variant.Text"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => ShowBartenderOrdersDialogAsync(context))">
                            View all
                        </MudButton>
                    </MudStack>
                }
            </div>
        </MudStack>
    </DetailsTemplate>
</DataAccordion>