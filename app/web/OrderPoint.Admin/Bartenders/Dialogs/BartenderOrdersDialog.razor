<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Receipt"/>
            <MudText Typo="Typo.h6">Bartender orders</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudPaper Class="pa-5 mb-5">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <BartenderAvatar FirstName="@Bartender.FirstName"
                                 LastName="@Bartender.LastName"
                                 ImageUrl="@Bartender.ImageUrl"
                                 Size="Size.Large"/>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">
                        @Bartender.FirstName @Bartender.LastName
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @Bartender.Email
                    </MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        <BartenderOrdersList BartenderId="@Bartender.Id"/>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   OnClick="@Close"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>