<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error"/>
            <MudText Typo="Typo.h6">Delete bartender</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Class="mb-4">
            <MudText Typo="Typo.body2">
                This action cannot be undone.
            </MudText>
        </MudAlert>

        <MudPaper Outlined="true" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <BartenderAvatar FirstName="@Bartender.FirstName"
                                 LastName="@Bartender.LastName"
                                 ImageUrl="@Bartender.ImageUrl"
                                 Size="Size.Large"/>

                <MudStack Spacing="1" Class="flex-1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">
                            @BartenderName
                        </MudText>

                        <MudChip T="string"
                                 Variant="Variant.Text"
                                 Size="Size.Small"
                                 Color="@(Bartender.Status is BartenderStatus.Active ? Color.Success : Color.Error)">
                            @Bartender.Status.ToString()
                        </MudChip>
                    </MudStack>

                    <MudText Typo="Typo.body2">
                        @Bartender.Email
                        @if (Bartender.PhoneNumber is not null)
                        {
                            @($" · {Bartender.PhoneNumber}")
                        }
                    </MudText>

                    <MudText Typo="Typo.caption">
                        Joined @Bartender.CreatedAtUtc.ToRelativeTime()
                    </MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.body2" Class="mt-4 mb-2">
            This also deletes:
        </MudText>

        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small"/>
                <MudText Typo="Typo.body2">Their login, so they can no longer sign in</MudText>
            </MudStack>

            @if (Bartender.ImageUrl is not null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small"/>
                    <MudText Typo="Typo.body2">Their photo</MudText>
                </MudStack>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
            Cancel
        </MudButton>

        <MudButton OnClick="@Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete">
            Delete @BartenderName
        </MudButton>
    </DialogActions>
</MudDialog>