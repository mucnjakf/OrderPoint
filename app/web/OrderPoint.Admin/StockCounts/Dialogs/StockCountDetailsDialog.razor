<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.FactCheck"/>
            <MudText Typo="Typo.h6">Stock count</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudPaper Class="pa-5">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
                    <MudAvatar Rounded="true" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck"/>
                    </MudAvatar>

                    <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
                        <MudText Typo="Typo.h6">
                            Closed @StockCount.ClosedAtUtc?.ToDisplayDateTime(TimeZoneService.TimeZone)
                        </MudText>

                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                            @SubtitleText
                        </MudText>
                    </MudStack>
                </MudStack>

                <div style="@FactsStyle">
                    @foreach ((string icon, string label, string value, string? style) in Facts)
                    {
                        <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                <MudIcon Icon="@icon" Size="Size.Small" Color="Color.Surface"/>

                                <MudText Typo="Typo.caption" Color="Color.Surface">
                                    @label
                                </MudText>
                            </MudStack>

                            <MudText Typo="Typo.body1" Style="@($"font-weight: 600; {style}")">
                                @value
                            </MudText>
                        </MudPaper>
                    }
                </div>
            </MudPaper>

            <MudPaper Class="pa-5">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    Stock items
                </MudText>

                <MudSimpleTable Elevation="0" Hover="true">
                    <thead>
                        <tr>
                            <th>Stock item</th>
                            <th>Expected</th>
                            <th>Counted</th>
                            <th>Difference</th>
                            <th style="text-align: right">Value</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (StockCountLineDto line in Lines)
                        {
                            <tr @key="@line.Id" style="@(line.CountedQuantity is null ? NotCountedStyle : null)">
                                <td>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@line.Group.GetIcon()" Size="Size.Small"/>
                                        <MudText Typo="Typo.body2">@line.StockItemName</MudText>
                                    </MudStack>
                                </td>

                                @if (line.CountedQuantity is { } counted)
                                {
                                    <td>@line.GetQuantityText(line.ExpectedQuantity ?? 0)</td>
                                    <td>@line.GetQuantityText(counted)</td>
                                    <td style="font-weight: 600">@line.GetQuantityChangeText()</td>
                                    <td style="@($"text-align: right; {(line.ValueChange ?? 0).GetValueChangeStyle()}")">
                                        @((line.ValueChange ?? 0).ToSignedMoneyText())
                                    </td>
                                }
                                else
                                {
                                    <td colspan="4">Not counted</td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Close" Variant="Variant.Text">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>