<MudCardContent>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px"/>

        <MudText Typo="Typo.h6" Class="flex-1">
            <MudSkeleton Width="60%"/>
        </MudText>

        <ChipSkeleton/>
    </MudStack>

    <MudStack Spacing="1" Class="mb-3">
        @for (int i = 0; i < ContactLinesCount; i++)
        {
            <MudText Typo="Typo.body2">
                <MudSkeleton Width="70%"/>
            </MudText>
        }
    </MudStack>

    <MudText Typo="Typo.body2">
        <MudSkeleton Width="50%"/>
    </MudText>

    <MudText Typo="Typo.caption">
        <MudSkeleton Width="40%"/>
    </MudText>
</MudCardContent>