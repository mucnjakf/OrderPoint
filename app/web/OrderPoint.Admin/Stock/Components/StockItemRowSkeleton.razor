<div style="@StockRowLayout.GridStyle">
    <MudText Typo="Typo.body1">
        <MudSkeleton Width="70%"/>
    </MudText>

    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="8px"/>

    <MudText Typo="Typo.body2">
        <MudSkeleton Width="80%"/>
    </MudText>

    <MudText Typo="Typo.body2">
        <MudSkeleton Width="60%"/>
    </MudText>

    <MudText Typo="Typo.body2">
        <MudSkeleton Width="60px" Class="ml-auto"/>
    </MudText>

    <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
        @for (int i = 0; i < ActionsCount; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="28px" Height="28px"/>
        }
    </MudStack>
</div>