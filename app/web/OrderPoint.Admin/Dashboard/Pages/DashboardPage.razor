@page "/"

<PageTitle>Dashboard</PageTitle>

<PageHeader Text="Dashboard">
    <MudToggleGroup T="DashboardPeriod"
                    @bind-Value="@SelectedPeriod"
                    @bind-Value:after="@OnPeriodChangedAsync"
                    Color="Color.Primary">
        @foreach (DashboardPeriod period in Enum.GetValues<DashboardPeriod>())
        {
            <MudToggleItem Value="@period" Text="@period.GetLabel()" Class="px-5 py-2"/>
        }
    </MudToggleGroup>
</PageHeader>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" lg="3">
        <DashboardKpiCard Label="Revenue"
                          Icon="@Icons.Material.Filled.Payments"
                          Color="Color.Success"
                          Value="@(Summary?.Revenue.ToString("C", CultureInfo.CurrentCulture) ?? "-")"
                          CurrentValue="@((double?)Summary?.Revenue)"
                          PreviousValue="@((double?)Summary?.PreviousRevenue)"
                          IsLoading="@IsLoadingSummary"/>
    </MudItem>

    <MudItem xs="12" sm="6" lg="3">
        <DashboardKpiCard Label="Orders"
                          Icon="@Icons.Material.Filled.Receipt"
                          Color="Color.Primary"
                          Value="@(Summary?.OrdersCount.ToString(CultureInfo.CurrentCulture) ?? "-")"
                          CurrentValue="@Summary?.OrdersCount"
                          PreviousValue="@Summary?.PreviousOrdersCount"
                          IsLoading="@IsLoadingSummary"/>
    </MudItem>

    <MudItem xs="12" sm="6" lg="3">
        <DashboardKpiCard Label="Average order"
                          Icon="@Icons.Material.Filled.ShoppingBasket"
                          Color="Color.Info"
                          Value="@(Summary?.AverageOrderValue.ToString("C", CultureInfo.CurrentCulture) ?? "-")"
                          CurrentValue="@((double?)Summary?.AverageOrderValue)"
                          PreviousValue="@((double?)Summary?.PreviousAverageOrderValue)"
                          IsLoading="@IsLoadingSummary"/>
    </MudItem>

    <MudItem xs="12" sm="6" lg="3">
        <DashboardKpiCard Label="Service time"
                          Icon="@Icons.Material.Filled.Timer"
                          Color="Color.Warning"
                          Value="@ServiceTimeText"
                          CurrentValue="@Summary?.AverageServiceMinutes"
                          PreviousValue="@Summary?.PreviousAverageServiceMinutes"
                          IsLowerBetter="true"
                          IsLoading="@IsLoadingSummary"/>
    </MudItem>

    <MudItem xs="12" lg="9">
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <DashboardTile Title="@($"Revenue · {SelectedPeriod.GetLabel()}")"
                               Icon="@Icons.Material.Filled.ShowChart"
                               IsLoading="@IsLoadingRevenueTrend"
                               ShowContent="@RevenueTrend.Any(point => point.Revenue > 0)"
                               EmptyStateText="No payments in this period"
                               ContentHeight="@RevenueTrendChart.ChartHeight">
                    <LoadingContent>
                        <RevenueTrendChartSkeleton/>
                    </LoadingContent>

                    <ChildContent>
                        <RevenueTrendChart Points="@RevenueTrend"
                                           IsHourly="@(SelectedPeriod is DashboardPeriod.Today)"/>
                    </ChildContent>
                </DashboardTile>
            </MudItem>

            <MudItem xs="12" md="7">
                <DashboardTile Title="Busiest times · last 4 weeks"
                               Icon="@Icons.Material.Filled.LocalFireDepartment"
                               IsLoading="@IsLoadingBusiestTimes"
                               ShowContent="@BusiestTimes.Any(slot => slot.OrdersCount > 0)"
                               EmptyStateText="No orders in the last 4 weeks">
                    <LoadingContent>
                        <BusiestTimesHeatMapSkeleton/>
                    </LoadingContent>

                    <ChildContent>
                        <BusiestTimesHeatMap BusiestTimes="@BusiestTimes"/>
                    </ChildContent>
                </DashboardTile>
            </MudItem>

            <MudItem xs="12" md="5">
                <DashboardTile Title="Revenue by category"
                               Icon="@Icons.Material.Filled.DonutLarge"
                               IsLoading="@IsLoadingCategoryRevenue"
                               ShowContent="@CategoryRevenue.Any()"
                               EmptyStateText="No payments in this period">
                    <LoadingContent>
                        <CategoryRevenueDonutSkeleton/>
                    </LoadingContent>

                    <ChildContent>
                        <CategoryRevenueDonut CategoryRevenue="@CategoryRevenue"/>
                    </ChildContent>
                </DashboardTile>
            </MudItem>

            <MudItem xs="12">
                <DashboardTile Title="@($"Payments by method · {SelectedPeriod.GetLabel()}")"
                               Icon="@Icons.Material.Filled.AccountBalanceWallet"
                               IsLoading="@IsLoadingPaymentMethods"
                               ShowContent="@HasPayments"
                               EmptyStateText="No payments in this period">
                    <LoadingContent>
                        <PaymentMethodsSummarySkeleton/>
                    </LoadingContent>

                    <ChildContent>
                        <PaymentMethodsSummary PaymentMethods="@(PaymentMethods!)"/>
                    </ChildContent>
                </DashboardTile>
            </MudItem>

            <MudItem xs="12">
                <DashboardTile Title="@($"Gross profit · {SelectedPeriod.GetLabel()}")"
                               Icon="@Icons.Material.Filled.Savings"
                               IsLoading="@IsLoadingGrossProfit"
                               ShowContent="@HasGrossProfit"
                               EmptyStateText="No sales in this period">
                    <LoadingContent>
                        <GrossProfitSummarySkeleton/>
                    </LoadingContent>

                    <ChildContent>
                        <GrossProfitSummary GrossProfit="@(GrossProfit!)"/>
                    </ChildContent>
                </DashboardTile>
            </MudItem>
        </MudGrid>
    </MudItem>

    <MudItem xs="12" lg="3">
        <div class="d-flex flex-column gap-3" style="height: 100%">
            <div class="flex-1">
                <DashboardTile Title="Right now"
                               Icon="@Icons.Material.Filled.Bolt"
                               IsLoading="@IsLoadingLive"
                               ShowContent="@(Live is not null)"
                               EmptyStateText="Live data unavailable">
                    <LoadingContent>
                        <LiveOrdersPanelSkeleton/>
                    </LoadingContent>

                    <ChildContent>
                        @if (Live is not null)
                        {
                            <LiveOrdersPanel Live="@Live" UpdatedAtUtc="@LiveUpdatedAtUtc"/>
                        }
                    </ChildContent>
                </DashboardTile>
            </div>

            <DashboardTile Title="Low stock"
                           Icon="@Icons.Material.Filled.Inventory2"
                           IsLoading="@IsLoadingLowStock"
                           ShowContent="@LowStockItems.Any()"
                           EmptyStateText="Everything is stocked">
                <HeaderContent>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ShoppingCart"
                               OnClick="@ShowReorderDialogAsync">
                        Reorder
                    </MudButton>
                </HeaderContent>

                <LoadingContent>
                    <LowStockListSkeleton/>
                </LoadingContent>

                <ChildContent>
                    <LowStockList StockItems="@LowStockItems"
                                  OutCount="@(StockSummary?.OutCount ?? 0)"
                                  LowCount="@(StockSummary?.LowCount ?? 0)"
                                  OnStockItemClick="@ShowStockItemDetailsDialogAsync"/>
                </ChildContent>
            </DashboardTile>
        </div>
    </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <DashboardTile Title="Top items"
                       Icon="@Icons.Material.Filled.EmojiEvents"
                       IsLoading="@IsLoadingTopItems"
                       ShowContent="@TopItems.Any()"
                       EmptyStateText="No items sold in this period">
            <LoadingContent>
                <TopItemsListSkeleton/>
            </LoadingContent>

            <ChildContent>
                <TopItemsList Items="@TopItems" OnItemClick="@ShowItemDetailsDialogAsync"/>
            </ChildContent>
        </DashboardTile>
    </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <DashboardTile Title="Bartender leaderboard"
                       Icon="@Icons.Material.Filled.MilitaryTech"
                       IsLoading="@IsLoadingLeaderboard"
                       ShowContent="@Leaderboard.Any()"
                       EmptyStateText="No handled orders in this period">
            <LoadingContent>
                <BartenderLeaderboardSkeleton/>
            </LoadingContent>

            <ChildContent>
                <BartenderLeaderboard Entries="@Leaderboard" OnBartenderClick="@ShowBartenderOrdersDialogAsync"/>
            </ChildContent>
        </DashboardTile>
    </MudItem>

    <MudItem xs="12" lg="4">
        <DashboardTile Title="Recent orders"
                       Icon="@Icons.Material.Filled.History"
                       IsLoading="@IsLoadingRecentOrders"
                       ShowContent="@RecentOrders.Any()"
                       EmptyStateText="No orders yet">
            <LoadingContent>
                <RecentOrdersListSkeleton/>
            </LoadingContent>

            <ChildContent>
                <RecentOrdersList Orders="@RecentOrders"
                                  IsOrderNew="@(order => NewRecentOrders.IsNew(order.Id))"
                                  OnOrderClick="@ShowOrderDetailsDialogAsync"/>
            </ChildContent>
        </DashboardTile>
    </MudItem>
</MudGrid>