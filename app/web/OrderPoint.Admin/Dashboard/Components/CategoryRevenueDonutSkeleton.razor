<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="flex-1">
    <div class="d-flex align-center justify-center" style="@DonutContainerStyle">
        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="160px" Height="160px"/>

        <div style="@HoleStyle"></div>
    </div>

    <MudStack Spacing="1" Class="flex-1">
        @for (int i = 0; i < CategoriesCount; i++)
        {
            <div class="d-flex align-center pa-1">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="10px" Height="10px"/>

                <MudText Typo="Typo.body2" Class="flex-1 ml-2">
                    <MudSkeleton Width="90px"/>
                </MudText>

                <MudText Typo="Typo.body2">
                    <MudSkeleton Width="60px"/>
                </MudText>
            </div>
        }
    </MudStack>
</MudStack>