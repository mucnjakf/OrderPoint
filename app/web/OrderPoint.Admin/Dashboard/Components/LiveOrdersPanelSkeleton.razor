<MudStack Spacing="2" Class="flex-1">
    @foreach (OrderStatus status in OpenStatuses)
    {
        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudAvatar Color="@status.GetColor()" Size="Size.Small" Rounded="true">
                    <MudIcon Icon="@status.GetIcon()" Size="Size.Small"/>
                </MudAvatar>

                <MudText Typo="Typo.body2" Class="flex-1">
                    @status.ToString()
                </MudText>

                <MudText Typo="Typo.h6">
                    <MudSkeleton Width="24px"/>
                </MudText>
            </MudStack>
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudAvatar Color="Color.Secondary" Size="Size.Small" Rounded="true">
                <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small"/>
            </MudAvatar>

            <MudText Typo="Typo.body2" Class="flex-1">
                Longest wait
            </MudText>

            <MudText Typo="Typo.subtitle1">
                <MudSkeleton Width="70px"/>
            </MudText>
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.overline" Class="mt-3">
        Today so far
    </MudText>

    @foreach (string[] row in TodayLabelRows)
    {
        <MudStack Row="true" Spacing="2">
            @foreach (string label in row)
            {
                <MudPaper Outlined="true" Class="pa-3 flex-1">
                    <MudText Typo="Typo.caption">
                        @label
                    </MudText>

                    <MudText Typo="Typo.h6">
                        <MudSkeleton Width="60px"/>
                    </MudText>
                </MudPaper>
            }
        </MudStack>
    }

    <MudSpacer/>

    <MudStack Spacing="0" AlignItems="AlignItems.Center">
        <MudButton Href="/orders"
                   Variant="Variant.Text"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward">
            View orders
        </MudButton>

        <MudText Typo="Typo.caption">
            <MudSkeleton Width="220px"/>
        </MudText>
    </MudStack>
</MudStack>