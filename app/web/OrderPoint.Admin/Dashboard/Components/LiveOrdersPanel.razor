<MudStack Spacing="2" Class="flex-1">
    @foreach (OrderStatus status in OpenStatuses)
    {
        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudAvatar Color="@status.GetColor()" Size="Size.Small" Rounded="true">
                    <MudIcon Icon="@status.GetIcon()" Size="Size.Small"/>
                </MudAvatar>

                <MudText Typo="Typo.body2" Class="flex-1">
                    @status.ToString()
                </MudText>

                <MudText Typo="Typo.h6">
                    @GetCount(status)
                </MudText>
            </MudStack>
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudAvatar Color="Color.Secondary" Size="Size.Small" Rounded="true">
                <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small"/>
            </MudAvatar>

            <MudText Typo="Typo.body2" Class="flex-1">
                Longest wait
            </MudText>

            <MudText Typo="Typo.subtitle1">
                @(Live.OldestOpenOrderCreatedAtUtc?.ToRelativeTime() ?? "None")
            </MudText>
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.overline" Class="mt-3">
        Today so far
    </MudText>

    <MudStack Row="true" Spacing="2">
        <MudPaper Outlined="true" Class="pa-3 flex-1">
            <MudText Typo="Typo.caption">
                Orders
            </MudText>

            <MudText Typo="Typo.h6">
                @Live.TodayOrdersCount
            </MudText>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-3 flex-1">
            <MudText Typo="Typo.caption">
                Completed
            </MudText>

            <MudText Typo="Typo.h6">
                @Live.TodayCompletedCount
            </MudText>
        </MudPaper>
    </MudStack>

    <MudStack Row="true" Spacing="2">
        <MudPaper Outlined="true" Class="pa-3 flex-1">
            <MudText Typo="Typo.caption">
                Revenue
            </MudText>

            <MudText Typo="Typo.h6">
                @Live.TodayRevenue.ToString("C", CultureInfo.CurrentCulture)
            </MudText>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-3 flex-1">
            <MudText Typo="Typo.caption">
                Average order
            </MudText>

            <MudText Typo="Typo.h6">
                @Live.TodayAverageOrderValue.ToString("C", CultureInfo.CurrentCulture)
            </MudText>
        </MudPaper>
    </MudStack>

    <MudSpacer/>

    <MudStack Spacing="0" AlignItems="AlignItems.Center">
        <MudButton Href="/orders"
                   Variant="Variant.Text"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward">
            View orders
        </MudButton>

        <MudText Typo="Typo.caption">
            Refreshes every 30 seconds · updated @UpdatedAtUtc.ToTimeZone(TimeZoneService.TimeZone).ToString("T")
        </MudText>
    </MudStack>
</MudStack>