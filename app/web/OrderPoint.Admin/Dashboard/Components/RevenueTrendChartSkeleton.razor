<div class="d-flex" style="@ContainerStyle">
    <div class="d-flex flex-column justify-space-between pr-3 pb-6">
        @for (int i = 0; i < YAxisLabelsCount; i++)
        {
            <MudText Typo="Typo.caption">
                <MudSkeleton Width="40px"/>
            </MudText>
        }
    </div>

    <div class="d-flex flex-column flex-1">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Class="flex-1"/>

        <div class="d-flex justify-space-between align-center" style="height: 24px;">
            @for (int i = 0; i < XAxisLabelsCount; i++)
            {
                <MudText Typo="Typo.caption">
                    <MudSkeleton Width="32px"/>
                </MudText>
            }
        </div>
    </div>
</div>