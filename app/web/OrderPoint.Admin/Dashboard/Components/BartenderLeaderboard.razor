<MudStack Spacing="1">
    @for (int i = 0; i < Entries.Count; i++)
    {
        BartenderLeaderboardEntryDto entry = Entries[i];
        int rank = i + 1;
        bool isLast = rank == Entries.Count;

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="3"
                  Class="pa-2 rounded cursor-pointer"
                  Style="@GetRowStyle(entry)"
                  @onclick="@(() => OnBartenderClickAsync(entry))"
                  @onmouseenter="@(() => HoveredBartenderId = entry.BartenderId)"
                  @onmouseleave="@(() => HoveredBartenderId = null)">
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary" Style="width: 20px;">
                @rank
            </MudText>

            <BartenderAvatar FirstName="@entry.FirstName"
                             LastName="@entry.LastName"
                             ImageUrl="@entry.ImageUrl"/>

            <MudStack Spacing="0" Class="flex-1">
                <MudText Typo="Typo.body2">
                    @entry.FirstName @entry.LastName
                </MudText>

                <MudText Typo="Typo.caption">
                    @entry.CompletedOrdersCount completed · @GetDeclineRateText(entry) declined
                </MudText>
            </MudStack>

            <MudText Typo="Typo.body1">
                @entry.Revenue.ToString("C", CultureInfo.CurrentCulture)
            </MudText>
        </MudStack>

        @if (!isLast)
        {
            <MudDivider/>
        }
    }
</MudStack>