<MudStack Spacing="2">
    @for (int i = 0; i < RowsCount; i++)
    {
        int rank = i + 1;

        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary" Style="width: 20px;">
                    @rank
                </MudText>

                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px"/>

                <MudStack Spacing="0" Class="flex-1">
                    <MudText Typo="Typo.body2">
                        <MudSkeleton Width="120px"/>
                    </MudText>

                    <MudText Typo="Typo.caption">
                        <MudSkeleton Width="140px"/>
                    </MudText>
                </MudStack>

                <MudText Typo="Typo.body1">
                    <MudSkeleton Width="60px"/>
                </MudText>
            </MudStack>
        </MudPaper>
    }
</MudStack>