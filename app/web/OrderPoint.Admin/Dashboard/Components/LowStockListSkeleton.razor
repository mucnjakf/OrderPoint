<MudStack Spacing="2">
    <MudStack Row="true" Spacing="2">
        <ChipSkeleton Size="Size.Small" Width="56px" Class="ma-0"/>

        <ChipSkeleton Size="Size.Small" Width="56px" Class="ma-0"/>
    </MudStack>

    @for (int i = 0; i < RowsCount; i++)
    {
        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="32px" Height="32px"/>

                <MudStack Spacing="0" Class="flex-1">
                    <MudText Typo="Typo.body2">
                        <MudSkeleton Width="100px"/>
                    </MudText>

                    <MudText Typo="Typo.caption">
                        <MudSkeleton Width="70px"/>
                    </MudText>
                </MudStack>

                <MudText Typo="Typo.body2">
                    <MudSkeleton Width="60px"/>
                </MudText>
            </MudStack>
        </MudPaper>
    }
</MudStack>