<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="flex-1">
    <div style="@DonutContainerStyle" @onmouseleave="@(() => HoveredIndex = null)">
        <svg viewBox="0 0 100 100" width="100%" height="100%" style="transform: rotate(-90deg);">
            <circle cx="50"
                    cy="50"
                    r="@Format(Radius)"
                    fill="none"
                    stroke-width="@Format(StrokeWidth)"
                    style="stroke: var(--mud-palette-lines-default);"/>

            @for (int i = 0; i < Segments.Count; i++)
            {
                int index = i;
                DonutSegment segment = Segments[index];

                <circle cx="50"
                        cy="50"
                        r="@Format(Radius)"
                        fill="none"
                        stroke-width="@Format(HoveredIndex == index ? HoveredStrokeWidth : StrokeWidth)"
                        stroke-dasharray="@segment.DashArray"
                        stroke-dashoffset="@segment.DashOffset"
                        style="@GetSegmentStyle(index)"
                        @onmouseenter="@(() => HoveredIndex = index)"/>
            }
        </svg>

        <div class="d-flex flex-column align-center justify-center" style="@CenterStyle">
            <MudText Typo="Typo.caption" Align="Align.Center">
                @CenterLabel
            </MudText>

            <MudText Typo="Typo.subtitle2" Align="Align.Center">
                @CenterValue
            </MudText>

            @if (HoveredIndex is not null)
            {
                <MudText Typo="Typo.caption" Align="Align.Center">
                    @Segments[HoveredIndex.Value].ShareText
                </MudText>
            }
        </div>
    </div>

    <MudStack Spacing="1" Class="flex-1">
        @for (int i = 0; i < CategoryRevenue.Count; i++)
        {
            int index = i;
            CategoryRevenueDto category = CategoryRevenue[index];

            <div class="d-flex align-center pa-1 rounded"
                 style="@GetLegendRowStyle(index)"
                 @onmouseenter="@(() => HoveredIndex = index)"
                 @onmouseleave="@(() => HoveredIndex = null)">
                <div style="@GetLegendDotStyle(index)"></div>

                <MudText Typo="Typo.body2" Class="flex-1 ml-2">
                    @category.CategoryName
                </MudText>

                <MudText Typo="Typo.body2">
                    @category.Revenue.ToString("C", CultureInfo.CurrentCulture)
                </MudText>
            </div>
        }
    </MudStack>
</MudStack>