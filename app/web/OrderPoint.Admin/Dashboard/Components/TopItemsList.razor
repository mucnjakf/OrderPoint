<MudStack Spacing="2">
    @for (int i = 0; i < Items.Count; i++)
    {
        TopItemDto item = Items[i];

        <MudPaper Outlined="true"
                  Class="pa-3 cursor-pointer"
                  Style="@GetRowStyle(item)"
                  @onclick="@(() => OnItemClickAsync(item))"
                  @onmouseenter="@(() => HoveredItemId = item.ItemId)"
                  @onmouseleave="@(() => HoveredItemId = null)">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudImage Src="@(item.ImageUrl ?? ImageUrls.Placeholder)"
                          Alt="Item image"
                          Width="40"
                          Height="40"
                          ObjectFit="ObjectFit.Cover"
                          Style="@ImageStyles.Rounded"/>

                <MudStack Spacing="1" Class="flex-1">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">
                            @item.Name
                        </MudText>

                        <MudText Typo="Typo.body2">
                            <RollingNumber Value="@item.Quantity" Text="@item.Quantity.ToString()"/> sold
                        </MudText>
                    </MudStack>

                    <MudProgressLinear Color="Color.Primary"
                                       Value="@GetShareOfTop(item)"
                                       Rounded="true"
                                       Size="Size.Small"/>

                    <MudText Typo="Typo.caption">
                        <RollingNumber Value="@item.Revenue"
                                       Text="@item.Revenue.ToString("C", CultureInfo.CurrentCulture)"/>
                    </MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    }
</MudStack>