<MudStack Spacing="3">
    @for (int i = 0; i < Items.Count; i++)
    {
        TopItemDto item = Items[i];
        bool isLast = i == Items.Count - 1;

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudImage Src="@(item.ImageUrl ?? "images/image-placeholder.svg")"
                      Alt="Item image"
                      Width="40"
                      Height="40"
                      ObjectFit="ObjectFit.Cover"/>

            <MudStack Spacing="1" Class="flex-1">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2">
                        @item.Name
                    </MudText>

                    <MudText Typo="Typo.body2">
                        @item.Quantity sold
                    </MudText>
                </MudStack>

                <MudProgressLinear Color="Color.Primary"
                                   Value="@GetShareOfTop(item)"
                                   Rounded="true"
                                   Size="Size.Small"/>

                <MudText Typo="Typo.caption">
                    @item.Revenue.ToString("C", CultureInfo.CurrentCulture)
                </MudText>
            </MudStack>
        </MudStack>

        @if (!isLast)
        {
            <MudDivider/>
        }
    }
</MudStack>