<MudStack Spacing="1">
    @foreach (DayOfWeek dayOfWeek in WeekDays)
    {
        DayOfWeek rowDay = dayOfWeek;

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.caption" Style="@DayLabelStyle">
                @GetDayLabel(rowDay)
            </MudText>

            @for (int hour = 0; hour < HoursPerDay; hour++)
            {
                int cellHour = hour;
                int ordersCount = GetOrdersCount(rowDay, cellHour);

                <MudTooltip Placement="Placement.Top" Arrow="true" Inline="false" RootClass="flex-1">
                    <ChildContent>
                        <div style="@GetCellStyle(ordersCount)"></div>
                    </ChildContent>

                    <TooltipContent>
                        <div class="pa-1">
                            <MudText Typo="Typo.caption">
                                @GetDayName(rowDay), @GetHourRange(cellHour)
                            </MudText>

                            <MudText Typo="Typo.subtitle2">
                                @ordersCount @(ordersCount == 1 ? "order" : "orders")
                            </MudText>
                        </div>
                    </TooltipContent>
                </MudTooltip>
            }
        </MudStack>
    }

    <MudStack Row="true" Spacing="1">
        <div style="@DayLabelStyle"></div>

        @for (int hour = 0; hour < HoursPerDay; hour++)
        {
            int labelHour = hour;

            <MudText Typo="Typo.caption" Class="flex-1" Align="Align.Center" Style="white-space: nowrap">
                @(labelHour % LabelHourStep == 0 ? GetHourLabel(labelHour) : string.Empty)
            </MudText>
        }
    </MudStack>
</MudStack>