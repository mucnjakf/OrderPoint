<div style="@FloorPlanEditorLayout.GridStyle">
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Style="@FloorPlanEditorLayout.ToolbarStyle">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="120px" Height="36px"/>
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="220px" Height="32px"/>
    </MudStack>

    <MudPaper Class="pa-3" Style="@FloorPlanEditorLayout.MapStyle">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Style="aspect-ratio: 3 / 2; height: auto"/>
    </MudPaper>

    <MudPaper Class="pa-5" Style="@FloorPlanEditorLayout.PanelStyle">
        <MudText Typo="Typo.h6">
            <MudSkeleton Width="60%"/>
        </MudText>

        <MudText Typo="Typo.body2" Class="mt-3">
            <MudSkeleton/>
        </MudText>

        <MudText Typo="Typo.body2">
            <MudSkeleton/>
        </MudText>

        <MudText Typo="Typo.body2">
            <MudSkeleton Width="80%"/>
        </MudText>
    </MudPaper>
</div>