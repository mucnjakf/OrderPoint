<EditForm Model="@Request" OnValidSubmit="@OnValidSubmit">
    <DataAnnotationsValidator/>

    <MudDialog ActionsClass="pa-6" Class="mud-background">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.TableRestaurant"/>
                <MudText Typo="Typo.h6">Edit table @Table.Code</MudText>
            </MudStack>
        </TitleContent>

        <DialogContent>
            <MudStack Spacing="0">
                <MudTextField Label="Code"
                              @bind-Value="@Request.Code"
                              For="@(() => Request.Code)"
                              HelperText="A new code needs a new printed QR code."
                              Variant="Variant.Outlined"
                              MaxLength="10"
                              Immediate="true"/>

                <MudStack Row="true" Spacing="3" Class="mt-5">
                    <MudNumericField T="int"
                                     Label="Seats"
                                     @bind-Value="@Request.Seats"
                                     For="@(() => Request.Seats)"
                                     HelperText="1 to 20."
                                     Min="1"
                                     Max="20"
                                     Variant="Variant.Outlined"
                                     Class="flex-1"
                                     Style="min-width: 0"
                                     Immediate="true"/>

                    <MudSelect T="TableStatus"
                               Label="Status"
                               @bind-Value="@Request.Status"
                               For="@(() => Request.Status)"
                               HelperText="An inactive table takes no orders."
                               Variant="Variant.Outlined"
                               Class="flex-1"
                               Style="min-width: 0">
                        @foreach (TableStatus value in Enum.GetValues<TableStatus>())
                        {
                            <MudSelectItem T="TableStatus" Value="@value">@value.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>

                <MudStack Row="true" Spacing="3" Class="mt-5">
                    <MudSelect T="TableShape"
                               Label="Shape"
                               @bind-Value="@Request.Shape"
                               For="@(() => Request.Shape)"
                               HelperText="How it is drawn on the floor plan."
                               Variant="Variant.Outlined"
                               Class="flex-1"
                               Style="min-width: 0">
                        @foreach (TableShape value in Enum.GetValues<TableShape>())
                        {
                            <MudSelectItem T="TableShape" Value="@value">@value.ToString()</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>

                <MudStack Row="true" Spacing="3" Class="mt-5">
                    <MudNumericField T="int"
                                     Label="Width"
                                     @bind-Value="@Request.Width"
                                     For="@(() => Request.Width)"
                                     HelperText="In cells, 1 to 12."
                                     Min="1"
                                     Max="12"
                                     Variant="Variant.Outlined"
                                     Class="flex-1"
                                     Style="min-width: 0"
                                     Immediate="true"/>

                    <MudNumericField T="int"
                                     Label="Height"
                                     @bind-Value="@Request.Height"
                                     For="@(() => Request.Height)"
                                     HelperText="In cells, 1 to 12."
                                     Min="1"
                                     Max="12"
                                     Variant="Variant.Outlined"
                                     Class="flex-1"
                                     Style="min-width: 0"
                                     Immediate="true"/>
                </MudStack>
            </MudStack>
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
                Cancel
            </MudButton>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save">
                Save
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>