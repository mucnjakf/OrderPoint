<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6">
        <MudSkeleton Width="30%"/>
    </MudText>

    <MudText Typo="Typo.caption">
        <MudSkeleton Width="60%"/>
    </MudText>
</MudPaper>

<MudText Typo="Typo.subtitle2" Class="mb-2">
    <MudSkeleton Width="20%"/>
</MudText>

<div style="@TableTilesLayout.GridStyle">
    @for (int i = 0; i < TilesCount; i++)
    {
        <MudPaper Class="pa-3" Style="text-align: center;">
            <MudText Typo="Typo.h6">
                <MudSkeleton Width="60%" Class="mx-auto"/>
            </MudText>

            <MudText Typo="Typo.caption">
                <MudSkeleton Width="80%" Class="mx-auto"/>
            </MudText>
        </MudPaper>
    }
</div>