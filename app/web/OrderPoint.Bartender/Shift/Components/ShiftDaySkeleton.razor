<MudGrid Spacing="3">
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4" Style="height: 100%;">
            <MudStack Spacing="4">
                <MudStack Row="true" Spacing="6">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.overline" Style="line-height: 1.4">
                            Served
                        </MudText>

                        <MudText Typo="Typo.h5">
                            <MudSkeleton Width="90px"/>
                        </MudText>
                    </MudStack>

                    <MudStack Spacing="0">
                        <MudText Typo="Typo.overline" Style="line-height: 1.4">
                            Items served
                        </MudText>

                        <MudText Typo="Typo.h5">
                            <MudSkeleton Width="40px"/>
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudStack Spacing="2">
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                        Completed orders per hour
                    </MudText>

                    <ShiftHoursChartSkeleton/>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="5">
        <MudPaper Class="pa-4" Style="height: 100%;">
            <MudStack Spacing="2">
                <MudText Typo="Typo.overline" Style="line-height: 1.4">
                    Most served
                </MudText>

                @for (int i = 0; i < RowsCount; i++)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="40px" Height="40px"/>

                            <MudStack Spacing="1" Class="flex-1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.body2">
                                        <MudSkeleton Width="110px"/>
                                    </MudText>

                                    <MudText Typo="Typo.body2">
                                        <MudSkeleton Width="24px"/>
                                    </MudText>
                                </MudStack>

                                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                             Height="4px"
                                             Style="border-radius: 2px;"/>

                                <MudText Typo="Typo.caption">
                                    <MudSkeleton Width="60px"/>
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>