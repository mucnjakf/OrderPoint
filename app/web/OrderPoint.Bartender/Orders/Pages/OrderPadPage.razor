@page "/tables/{TableCode}/order"
@page "/counter/order"

<PageTitle>New order</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Href="/"
                   aria-label="Back to the tables"/>

    <MudStack Spacing="0">
        <MudText Typo="Typo.h6" HtmlTag="h1">
            @PlaceText
        </MudText>

        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
            New order
        </MudText>
    </MudStack>
</MudStack>

<div style="@SearchWrapperStyle">
    <MudTextField @bind-Value="@SearchQuery"
                  T="string"
                  Placeholder="Search categories"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  DebounceInterval="300"
                  Immediate="true"/>
</div>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@FoundCategories.Any()"
              EmptyStateIcon="@EmptyStateIcon"
              EmptyStateText="@EmptyStateText"
              EmptyStateDetail="@EmptyStateDetail">
    <LoadingContent>
        <MudGrid Spacing="2">
            @for (int i = 0; i < LoadingCardsCount; i++)
            {
                <MudItem xs="6" sm="4">
                    <MenuCategoryCardSkeleton/>
                </MudItem>
            }
        </MudGrid>
    </LoadingContent>

    <ChildContent>
        <MudGrid Spacing="2">
            @foreach (MenuCategoryDto category in FoundCategories)
            {
                MenuCategoryDto cardCategory = category;

                <MudItem @key="@cardCategory.Id" xs="6" sm="4">
                    <MenuCategoryCard Category="@cardCategory" OnClick="@OpenCategory"/>
                </MudItem>
            }
        </MudGrid>
    </ChildContent>
</StatefulView>

<OrderSummaryBar ItemsCount="@Draft.ItemsCount" Total="@Draft.GetTotal(Menu)" ReviewUri="@ReviewUri"/>