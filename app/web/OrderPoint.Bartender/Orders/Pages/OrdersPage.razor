@page "/"

<PageTitle>Orders</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">
    Orders
</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="@(IsSplitView ? 5 : 12)">
        <div style="@ListHeaderWrapperStyle">
            <MudTextField @bind-Value="@SearchQuery"
                          @bind-Value:after="@OnSearchChangedAsync"
                          T="string"
                          Placeholder="Order number or table"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          DebounceInterval="500"
                          Immediate="false"/>

            @if (!IsSearching)
            {
                <MudPaper Class="d-flex mt-3" Style="@TabBarStyle">
                    @foreach (OrdersTab tab in Enum.GetValues<OrdersTab>())
                    {
                        OrdersTab tabValue = tab;

                        <MudButton Variant="Variant.Text"
                                   Class="flex-1"
                                   Style="@GetTabStyle(tabValue)"
                                   OnClick="@(() => SelectTab(tabValue))">
                            @tabValue.ToString() <TabCount Count="@GetTabCount(tabValue)"/>
                        </MudButton>
                    }
                </MudPaper>
            }
        </div>

        @if (IsSearching)
        {
            @if (!IsLoadingSearchResults && SearchResults.Count != 0)
            {
                <MudText Typo="Typo.caption" Class="d-block mb-2" Style="color: var(--mud-palette-text-secondary)">
                    @SearchResultsTotalCount.ToCountText("order found", "orders found")
                </MudText>
            }

            <OrderTicketList Orders="@SearchResults"
                             IsLoading="@IsLoadingSearchResults"
                             SelectedOrderId="@SelectedOrderId"
                             ShowsBartender="true"
                             OnOrderClick="@SelectOrder"
                             EmptyStateIcon="@Icons.Material.Filled.SearchOff"
                             EmptyStateText="No orders found"
                             EmptyStateDetail="Try another number or table."/>

            @if (!IsLoadingSearchResults && HasMoreSearchResults)
            {
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Large"
                           FullWidth="true"
                           Class="mt-3"
                           Disabled="@IsLoadingMoreSearchResults"
                           OnClick="@ShowMoreSearchResultsAsync">
                    @if (IsLoadingMoreSearchResults)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2"/>
                    }

                    Show more
                </MudButton>
            }
        }
        else
        {
            @switch (OrdersTabState.Tab)
            {
                case OrdersTab.Queue:
                    <OrderTicketList Orders="@QueueOrders"
                                     IsLoading="@IsLoadingQueue"
                                     SelectedOrderId="@SelectedOrderId"
                                     OnOrderClick="@SelectOrder"
                                     IsOrderNew="@(order => NewQueueOrders.IsNew(order.Id))"
                                     EmptyStateIcon="@Icons.Material.Filled.Inbox"
                                     EmptyStateText="No orders waiting"
                                     EmptyStateDetail="New orders show up here by themselves."/>
                    break;

                case OrdersTab.Mine:
                    <OrderTicketList Orders="@MyOrders"
                                     IsLoading="@IsLoadingMine"
                                     SelectedOrderId="@SelectedOrderId"
                                     OnOrderClick="@SelectOrder"
                                     EmptyStateIcon="@Icons.Material.Filled.LocalBar"
                                     EmptyStateText="Nothing in progress"
                                     EmptyStateDetail="Accept an order from the queue."/>
                    break;

                case OrdersTab.Done:
                    <OrderTicketList Orders="@DoneOrders"
                                     IsLoading="@IsLoadingDone"
                                     SelectedOrderId="@SelectedOrderId"
                                     OnOrderClick="@SelectOrder"
                                     EmptyStateIcon="@Icons.Material.Filled.TaskAlt"
                                     EmptyStateText="Nothing finished today yet"
                                     EmptyStateDetail="Completed and declined orders show up here."/>
                    break;
            }
        }
    </MudItem>

    @if (IsSplitView)
    {
        <MudItem sm="7">
            <div style="@DetailsPanelStyle">
                @if (SelectedOrderId is not null)
                {
                    <OrderDetails @key="@SelectedOrderId"
                                  OrderId="@SelectedOrderId.Value"
                                  IsInPanel="true"
                                  OnFinished="@ClearSelection"
                                  OnClose="@ClearSelection"/>
                }
                else
                {
                    <MudPaper Class="pa-10">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Class="mb-2"/>

                            <MudText Typo="Typo.body1" Align="Align.Center">
                                Select an order
                            </MudText>

                            <MudText Typo="Typo.body2"
                                     Align="Align.Center"
                                     Style="color: var(--mud-palette-text-secondary)">
                                Its details and actions show up here.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            </div>
        </MudItem>
    }
</MudGrid>