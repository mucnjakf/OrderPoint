@page "/tables/{TableCode}/order/{CategoryId:guid}"
@page "/counter/order/{CategoryId:guid}"

<PageTitle>@(Category?.Name ?? "New order")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Href="@OrderPadUri"
                   aria-label="Back to the categories"/>

    <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
        <MudText Typo="Typo.h6" HtmlTag="h1" Style="overflow-wrap: anywhere">
            @if (IsLoading)
            {
                <MudSkeleton Width="120px"/>
            }
            else
            {
                @(Category?.Name ?? "New order")
            }
        </MudText>

        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
            @PlaceText
        </MudText>
    </MudStack>
</MudStack>

<div style="@SearchWrapperStyle">
    <MudTextField @bind-Value="@SearchQuery"
                  T="string"
                  Placeholder="Search items"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  DebounceInterval="300"
                  Immediate="true"/>
</div>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@FoundItems.Any()"
              EmptyStateIcon="@EmptyStateIcon"
              EmptyStateText="@EmptyStateText"
              EmptyStateDetail="@EmptyStateDetail">
    <LoadingContent>
        <MudStack Spacing="2">
            @for (int i = 0; i < LoadingRowsCount; i++)
            {
                <MudPaper Class="pa-3">
                    <MenuItemRowSkeleton/>
                </MudPaper>
            }
        </MudStack>
    </LoadingContent>

    <ChildContent>
        <MudStack Spacing="2">
            @foreach (MenuItemDto item in FoundItems)
            {
                MenuItemDto rowItem = item;

                <MenuItemRow @key="@rowItem.Id"
                             Item="@rowItem"
                             CartQuantity="@Draft.GetQuantity(rowItem.Id)"
                             MaxQuantity="@OrderDraft.MaxQuantity"
                             OnClick="@OpenItem"
                             OnAdd="@AddItem"
                             OnCartQuantityChanged="@(quantity => SetQuantity(rowItem, quantity))"/>
            }
        </MudStack>
    </ChildContent>
</StatefulView>

<OrderSummaryBar ItemsCount="@Draft.ItemsCount" Total="@Draft.GetTotal(Menu)" ReviewUri="@ReviewUri"/>