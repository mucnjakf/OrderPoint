@page "/account/password"

<PageTitle>Change password</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Href="/account"
                   aria-label="Back to the account"/>

    <MudText Typo="Typo.h6" HtmlTag="h1">
        Change password
    </MudText>
</MudStack>

<EditForm Model="@Request" OnValidSubmit="@ChangePasswordAsync">
    <DataAnnotationsValidator/>

    <MudPaper Class="pa-5">
        <MudStack Spacing="4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                <MudText Typo="Typo.body2">
                    You stay signed in here; every other device is signed out.
                </MudText>
            </MudAlert>

            <MudTextField Label="Current password"
                          @bind-Value="@Request.CurrentPassword"
                          For="@(() => Request.CurrentPassword)"
                          InputType="@PasswordInputType"
                          Variant="Variant.Outlined"
                          Immediate="true"/>

            <MudTextField Label="New password"
                          @bind-Value="@Request.NewPassword"
                          For="@(() => Request.NewPassword)"
                          InputType="@PasswordInputType"
                          HelperText="8+ characters, upper and lower case and a digit."
                          Variant="Variant.Outlined"
                          Immediate="true"/>

            <MudTextField Label="Confirm new password"
                          @bind-Value="@Request.ConfirmPassword"
                          For="@(() => Request.ConfirmPassword)"
                          InputType="@PasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordVisibilityIcon"
                          AdornmentAriaLabel="Show or hide passwords"
                          OnAdornmentClick="@TogglePasswordVisibility"
                          Variant="Variant.Outlined"
                          Immediate="true"/>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="@IsSaving"
                       StartIcon="@(IsSaving ? null : Icons.Material.Filled.Password)">
                @if (IsSaving)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2"/>
                }

                Change password
            </MudButton>
        </MudStack>
    </MudPaper>
</EditForm>