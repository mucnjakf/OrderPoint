<MudPaper Class="pa-3 cursor-pointer" Style="height: 100%;" @onclick="@OnCardClickAsync">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudImage Src="@(Category.ImageUrl ?? ImageUrls.Placeholder)"
                  Alt="Category image"
                  Width="56"
                  Height="56"
                  ObjectFit="ObjectFit.Cover"
                  Style="@ImageStyle"/>

        <MudText Typo="Typo.body2" Align="Align.Center" Style="@NameStyle">
            @Category.Name
        </MudText>

        <MudChip T="string"
                 Variant="Variant.Text"
                 Size="Size.Small"
                 Color="@(Category.Status is CategoryStatus.Active ? Color.Success : Color.Error)"
                 Class="ma-0">
            @Category.Status.ToString()
        </MudChip>
    </MudStack>
</MudPaper>