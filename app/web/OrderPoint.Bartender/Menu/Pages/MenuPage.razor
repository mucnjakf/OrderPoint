@page "/menu"

<PageTitle>Menu</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">
    Menu
</MudText>

<div style="@SearchWrapperStyle">
    <MudTextField @bind-Value="@SearchQuery"
                  @bind-Value:after="@OnSearchChangedAsync"
                  T="string"
                  Label="Search categories"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  DebounceInterval="500"
                  Immediate="false"/>
</div>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@Categories.Any()"
              EmptyStateIcon="@Icons.Material.Filled.MenuBook"
              EmptyStateText="No categories found"
              EmptyStateDetail="Try another search.">
    <LoadingContent>
        <MudGrid Spacing="3">
            @for (int i = 0; i < LoadingCardsCount; i++)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MenuCategoryCardSkeleton/>
                </MudItem>
            }
        </MudGrid>
    </LoadingContent>

    <ChildContent>
        <MudGrid Spacing="3">
            @foreach (CategoryDto category in Categories)
            {
                <MudItem @key="@category.Id" xs="6" sm="4" md="3">
                    <MenuCategoryCard Category="@category" OnClick="@OpenCategory"/>
                </MudItem>
            }
        </MudGrid>
    </ChildContent>
</StatefulView>