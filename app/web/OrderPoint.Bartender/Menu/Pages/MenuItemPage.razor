@page "/menu/{CategoryId:guid}/items/{ItemId:guid}"

<PageTitle>@(Item?.Name ?? "Item")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Href="@($"/menu/{CategoryId}")"
                   aria-label="Back to the category"/>

    <MudText Typo="Typo.h6" HtmlTag="h1" Class="flex-1" Style="min-width: 0; overflow-wrap: anywhere">
        @if (IsLoading)
        {
            <MudSkeleton Width="140px"/>
        }
        else
        {
            @(Item?.Name ?? "Item")
        }
    </MudText>
</MudStack>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@(Item is not null)"
              EmptyStateIcon="@Icons.Material.Filled.MenuBook"
              EmptyStateText="Item not found"
              EmptyStateDetail="It may have been removed from the menu.">
    <LoadingContent>
        <MenuItemDetailsSkeleton/>
    </LoadingContent>

    <ChildContent>
        <MenuItemDetails Item="@(Item!)"/>
    </ChildContent>
</StatefulView>