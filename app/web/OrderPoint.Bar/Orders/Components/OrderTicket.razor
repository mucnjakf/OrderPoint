<NewItemHighlight IsNew="@IsNew">
    <MudPaper Class="pa-3 cursor-pointer" Style="@PaperStyle" @onclick="@OnTicketClickAsync">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <OrderAvatar Number="@Order.Number"/>

                <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
                    <MudText Typo="Typo.body1">
                        @Order.GetPlaceText()
                    </MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                            <span style="@WaitStyle">@TimeText</span>@(ShowsHandler ? " ·" : null)
                        </MudText>

                        @if (ShowsHandler)
                        {
                            <BartenderAvatar FirstName="@Order.Bartender!.FirstName"
                                             LastName="@Order.Bartender.LastName"
                                             ImageUrl="@Order.Bartender.ImageUrl"
                                             Size="Size.Small"/>

                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                                @BartenderText
                            </MudText>
                        }
                    </MudStack>
                </MudStack>

                <MudStack Spacing="1" AlignItems="AlignItems.End">
                    <MudText Typo="Typo.h6">
                        @Order.Total.ToString("C", CultureInfo.CurrentCulture)
                    </MudText>

                    <MudChip T="string"
                             Variant="Variant.Text"
                             Size="Size.Small"
                             Color="@Order.Status.GetColor()"
                             Class="ma-0">
                        @Order.Status.ToString()
                    </MudChip>
                </MudStack>
            </MudStack>

            <MudDivider/>

            @foreach (OrderItemDto orderItem in Order.Items)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudImage Src="@(orderItem.ImageUrl ?? ImageUrls.Placeholder)"
                              Alt="Item image"
                              Width="24"
                              Height="24"
                              ObjectFit="ObjectFit.Cover"
                              Style="@($"{ImageStyles.RoundedSmall} flex-shrink: 0;")"/>

                    <MudText Typo="Typo.body1">
                        <strong>@orderItem.Quantity×</strong> @orderItem.Name
                    </MudText>
                </MudStack>
            }

            @if (Order.Note is not null)
            {
                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary); font-style: italic">
                    "@Order.Note"
                </MudText>
            }

            @if (Order.TakenByBartender is { } takenBy)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <BartenderAvatar FirstName="@takenBy.FirstName"
                                     LastName="@takenBy.LastName"
                                     ImageUrl="@takenBy.ImageUrl"
                                     Size="Size.Small"/>

                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                        @TakenByText
                    </MudText>
                </MudStack>
            }
        </MudStack>
    </MudPaper>
</NewItemHighlight>