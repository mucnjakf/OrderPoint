<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                     Width="72px"
                     Height="44px"
                     Style="border-radius: var(--mud-default-borderradius);"/>

        <MudStack Spacing="0" Class="flex-1">
            <MudText Typo="Typo.h6">
                <MudSkeleton Width="100px"/>
            </MudText>

            <MudText Typo="Typo.caption">
                <MudSkeleton Width="110px"/>
            </MudText>
        </MudStack>

        <ChipSkeleton Width="80px"/>
    </MudStack>

    <MudDivider/>

    @for (int i = 0; i < OrderLinesCount; i++)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="40px" Height="40px"/>

            <MudText Typo="Typo.body1" Class="flex-1">
                <MudSkeleton Width="150px"/>
            </MudText>

            <MudText Typo="Typo.body2">
                <MudSkeleton Width="50px"/>
            </MudText>
        </MudStack>
    }

    <MudDivider/>

    <MudStack Row="true" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">Total</MudText>

        <MudText Typo="Typo.h6">
            <MudSkeleton Width="70px"/>
        </MudText>
    </MudStack>
</MudStack>