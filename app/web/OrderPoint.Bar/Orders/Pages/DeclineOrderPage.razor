@page "/orders/{Id:guid}/decline"

<PageTitle>Decline order</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Href="@BackHref"
                   aria-label="Back to the order"/>

    <MudText Typo="Typo.h6" HtmlTag="h1">
        @if (IsLoading)
        {
            <MudSkeleton Width="160px"/>
        }
        else
        {
            @(Order is null ? "Decline order" : $"Decline order #{Order.Number}")
        }
    </MudText>
</MudStack>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@(Order is not null)"
              EmptyStateIcon="@Icons.Material.Filled.SearchOff"
              EmptyStateText="Order not found">
    <LoadingContent>
        <MudPaper Class="pa-3">
            <OrderTicketSkeleton/>
        </MudPaper>
    </LoadingContent>

    <ChildContent>
        <MudStack Spacing="3">
            <OrderTicket Order="@(Order!)" OnClick="@BackToOrder"/>

            <EditForm Model="@Request" OnValidSubmit="@DeclineAsync">
                <DataAnnotationsValidator/>

                <MudPaper Class="pa-5">
                    <MudStack Spacing="4">
                        @if (CanDecline)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">
                                <MudText Typo="Typo.body2">
                                    A declined order can't be accepted again.
                                </MudText>
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                                <MudText Typo="Typo.body2">
                                    This order can't be declined by you anymore.
                                </MudText>
                            </MudAlert>
                        }

                        <DeclineReasonField @bind-Reason="@Request.Reason" For="@(() => Request.Reason)"/>

                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   Disabled="@(IsDeclining || !CanDecline || string.IsNullOrWhiteSpace(Request.Reason))"
                                   StartIcon="@(IsDeclining ? null : Icons.Material.Filled.Block)">
                            @if (IsDeclining)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2"/>
                            }

                            Decline order
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </EditForm>
        </MudStack>
    </ChildContent>
</StatefulView>