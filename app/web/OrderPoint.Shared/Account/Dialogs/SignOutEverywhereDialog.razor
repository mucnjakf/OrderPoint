<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning"/>
            <MudText Typo="Typo.h6">Sign out everywhere</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mb-3">
            <MudText Typo="Typo.body2">
                Every device signed in with this account is signed out, including this one.
            </MudText>
        </MudAlert>

        <MudText Typo="Typo.body1">
            Use this after signing in on a shared or lost device. You can sign in again right away.
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
            Cancel
        </MudButton>

        <MudButton OnClick="@Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Logout">
            Sign out everywhere
        </MudButton>
    </DialogActions>
</MudDialog>