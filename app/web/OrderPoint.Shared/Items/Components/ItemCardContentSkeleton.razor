            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="16px" Height="16px"/>

            <MudText Typo="Typo.caption">
                <MudSkeleton Width="80px"/>
            </MudText>
        </MudStack>

        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="52px" Height="20px" Style="border-radius: 10px;"/>
    </MudStack>

    <MudText Typo="Typo.h6">
        <MudSkeleton Width="60%"/>
    </MudText>

    <MudText Typo="Typo.body2" Class="mt-1">
        <MudSkeleton/>
        <MudSkeleton Width="70%"/>
    </MudText>

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-auto pt-4">
        <MudText Typo="Typo.h6">
            <MudSkeleton Width="70px"/>
        </MudText>

        <MudText Typo="Typo.caption">
            <MudSkeleton Width="90px"/>
        </MudText>
    </MudStack>
</MudCardContent>