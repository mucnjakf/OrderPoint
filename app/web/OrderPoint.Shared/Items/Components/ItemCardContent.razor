<ItemCardImage ImageUrl="@ImageUrl" IsActive="@IsActive"/>

<MudCardContent Class="d-flex flex-column">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="mb-1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-width: 0">
            <MudImage Src="@(CategoryImageUrl ?? ImageUrls.Placeholder)"
                      Alt="Category image"
                      Width="16"
                      Height="16"
                      ObjectFit="ObjectFit.Cover"/>

            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                @CategoryName
            </MudText>
        </MudStack>

        @if (ShowsStatus)
        {
            <MudChip T="string"
                     Variant="Variant.Text"
                     Size="Size.Small"
                     Color="@(IsActive ? Color.Success : Color.Error)"
                     Class="ma-0"
                     Style="@StatusChipStyle">
                @StatusText
            </MudChip>
        }
    </MudStack>

    <MudText Typo="Typo.h6">
        @Name
    </MudText>

    <MudText Typo="Typo.body2" Class="mt-1" Style="@DescriptionStyle">
        @Description
    </MudText>

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-auto pt-4">
        <MudText Typo="Typo.h6">
            @PriceText
        </MudText>

        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
            @if (Portion is not null)
            {
                @PortionText
            }

            @if (Portion is not null && OrdersCount is not null)
            {
                @Separator
            }

            @if (OrdersCount is not null)
            {
                <RollingNumber Value="@OrdersCount.Value" Text="@OrdersCountText"/>
            }
        </MudText>
    </MudStack>
</MudCardContent>