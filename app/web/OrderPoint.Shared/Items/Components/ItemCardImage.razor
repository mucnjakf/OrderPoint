<div class="d-flex align-center justify-center" style="@ContainerStyle">
    @if (ImageUrl is null)
    {
        <MudImage Src="@ImageUrls.Placeholder"
                  Alt="Item image"
                  Width="@PlaceholderSize"
                  Height="@PlaceholderSize"
                  Style="@($"{ImageStyles.Rounded} {InactiveImageStyle}")"/>
    }
    else
    {
        <div style="@BackdropStyle"></div>
        <MudImage Src="@ImageUrl"
                  Alt="Item image"
                  Height="@ImageHeight"
                  ObjectFit="ObjectFit.Contain"
                  Style="@($"position: relative; max-width: 100%; {ImageStyles.Rounded} {InactiveImageStyle}")"/>
    }
</div>