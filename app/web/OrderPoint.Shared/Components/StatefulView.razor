@if (IsLoading)
{
    if (LoadingContent is not null)
    {
        @LoadingContent
    }
    else if (Compact)
    {
        <MudProgressCircular Indeterminate="true" Class="ma-auto" Style="height: 80px; width: 80px;">
            <ChildContent>
                <MudText Typo="Typo.caption">
                    Loading...
                </MudText>
            </ChildContent>
        </MudProgressCircular>
    }
    else if (Flat)
    {
        <div class="pa-10 d-flex flex-grow-1 justify-center align-center">
            <MudProgressCircular Indeterminate="true" Style="height: 100px; width: 100px;">
                <ChildContent>
                    Loading...
                </ChildContent>
            </MudProgressCircular>
        </div>
    }
    else
    {
        <MudPaper Class="pa-10 d-flex justify-center mb-3">
            <MudProgressCircular Indeterminate="true" Style="height: 100px; width: 100px;">
                <ChildContent>
                    Loading...
                </ChildContent>
            </MudProgressCircular>
        </MudPaper>
    }
}
else if (ShowContent)
{
    @ChildContent
}
else if (EmptyStateIcon is not null && EmptyStateText is not null)
{
    if (Compact)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="my-auto">
            <MudIcon Icon="@EmptyStateIcon"/>

            <MudText Typo="Typo.body2">
                @EmptyStateText
            </MudText>
        </MudStack>
    }
    else if (Flat)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-10 flex-grow-1">
            <MudIcon Icon="@EmptyStateIcon" Size="Size.Large" Class="mb-1"/>

            <MudText Typo="Typo.body1">
                @EmptyStateText
            </MudText>
        </MudStack>
    }
    else
    {
        <MudPaper Class="pa-10 mb-3">
            <MudStack AlignItems="AlignItems.Center">
                <MudIcon Icon="@EmptyStateIcon" Size="Size.Large" Class="mb-1"/>

                <MudText Typo="Typo.body1">
                    @EmptyStateText
                </MudText>
            </MudStack>
        </MudPaper>
    }
}