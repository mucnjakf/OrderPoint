@page "/Error"
@layout ErrorLayout
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Error</PageTitle>

<StatusMessage Icon="@Icons.Material.Filled.ErrorOutline"
               Title="Something went wrong"
               Text="An unexpected error occurred. Try again, or go back to the menu."
               Caption="@($"Request ID: {RequestId}")"
               ButtonText="Back to the menu"
               ButtonIcon="@Icons.Material.Filled.MenuBook"/>