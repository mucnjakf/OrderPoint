<nav style="@NavigationStyle">
    @foreach ((string href, string label, string icon) in Destinations)
    {
        string destinationHref = href;
        int badgeCount = GetBadgeCount(destinationHref);

        <MudButton Href="@destinationHref"
                   Variant="Variant.Text"
                   Color="@(IsActive(destinationHref) ? Color.Primary : Color.Default)"
                   Class="flex-1"
                   Style="@(IsActive(destinationHref) ? ActiveButtonStyle : InactiveButtonStyle)">
            <MudStack AlignItems="AlignItems.Center" Spacing="0">
                <MudBadge Content="@badgeCount"
                          Visible="@(badgeCount > 0)"
                          Color="Color.Primary"
                          Origin="Origin.CenterRight"
                          Overlap="true">
                    <MudIcon Icon="@icon" />
                </MudBadge>
                <MudText Typo="Typo.caption">@label</MudText>
            </MudStack>
        </MudButton>
    }
</nav>