<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.DoNotDisturbOn"/>
            <MudText Typo="Typo.h6">Cancel order #@OrderNumber</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body1">
            No bartender has taken it yet. Are you sure you want to cancel it?
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
            Keep order
        </MudButton>

        <MudButton OnClick="@Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DoNotDisturbOn">
            Cancel order
        </MudButton>
    </DialogActions>
</MudDialog>