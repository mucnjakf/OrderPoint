@page "/orders"

<PageTitle>My orders</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    My orders
</MudText>

<MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
    Placed on this phone in the last 12 hours.
</MudText>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@Orders.Any()"
              EmptyStateIcon="@Icons.Material.Filled.Receipt"
              EmptyStateText="No orders yet"
              EmptyStateDetail="The orders you place show up here.">
    <LoadingContent>
        <MudStack Spacing="3">
            @for (int i = 0; i < LoadingCardsCount; i++)
            {
                <MudPaper Class="pa-3">
                    <MyOrderCardSkeleton/>
                </MudPaper>
            }
        </MudStack>
    </LoadingContent>

    <ChildContent>
        <MudStack Spacing="3">
            @foreach (OrderTrackingDto order in Orders)
            {
                <MyOrderCard @key="@order.Id" Order="@order" OnClick="@OpenOrder" OnOrderAgain="@OrderAgainAsync"/>
            }
        </MudStack>
    </ChildContent>
</StatefulView>