<MudPaper Class="pa-3 cursor-pointer" @onclick="@OnCardClickAsync">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <OrderAvatar Number="@Order.Number"/>

            <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
                <MudText Typo="Typo.body1">
                    Table @Order.TableCode
                </MudText>

                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                    @Order.CreatedAtUtc.ToDisplayDateTime(TimeZoneService.TimeZone)
                </MudText>
            </MudStack>

            <MudStack Spacing="1" AlignItems="AlignItems.End">
                <MudText Typo="Typo.h6">
                    @Order.Total.ToString("C", CultureInfo.CurrentCulture)
                </MudText>

                <MudChip T="string"
                         Variant="Variant.Text"
                         Size="Size.Small"
                         Color="@Order.Status.GetColor()"
                         Class="ma-0">
                    @Order.Status.GetGuestTitle()
                </MudChip>

                @if (IsToPay)
                {
                    <MudChip T="string"
                             Variant="Variant.Outlined"
                             Size="Size.Small"
                             Color="Color.Warning"
                             Icon="@Icons.Material.Filled.Payments"
                             Class="ma-0">
                        To pay
                    </MudChip>
                }
            </MudStack>
        </MudStack>

        <MudStack Spacing="1">
            @foreach (OrderItemDto orderItem in Order.Items)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudImage Src="@(orderItem.ImageUrl ?? ImageUrls.Placeholder)"
                              Alt="Item image"
                              Width="24"
                              Height="24"
                              ObjectFit="ObjectFit.Cover"
                              Style="@($"{ImageStyles.RoundedSmall} flex-shrink: 0;")"/>

                    <MudText Typo="Typo.body2">
                        <strong>@orderItem.Quantity×</strong> @orderItem.Name
                    </MudText>
                </MudStack>
            }
        </MudStack>

        @* Cancelling or ordering again must not open the order as well *@
        <div @onclick:stopPropagation="true">
            <MudStack Row="true" Spacing="2">
                @if (CanCancel)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Class="flex-1"
                               StartIcon="@Icons.Material.Filled.DoNotDisturbOn"
                               Disabled="@IsCancelling"
                               OnClick="@OnCancelClickAsync">
                        Cancel
                    </MudButton>
                }

                <MudButton Variant="Variant.Outlined"
                           Class="flex-1"
                           StartIcon="@Icons.Material.Filled.Replay"
                           OnClick="@OnOrderAgainClickAsync">
                    Order again
                </MudButton>
            </MudStack>
        </div>
    </MudStack>
</MudPaper>