<MudPaper Class="pa-3 cursor-pointer" @onclick="@OnCardClickAsync">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <OrderAvatar Number="@Order.Number"/>

            <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
                <MudText Typo="Typo.body1">
                    Table @Order.TableCode
                </MudText>

                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                    @Order.CreatedAtUtc.ToDisplayDateTime(TimeZoneService.TimeZone)
                </MudText>
            </MudStack>

            <MudStack Spacing="1" AlignItems="AlignItems.End">
                <MudText Typo="Typo.h6">
                    @Order.Total.ToString("C", CultureInfo.CurrentCulture)
                </MudText>

                <MudChip T="string"
                         Variant="Variant.Text"
                         Size="Size.Small"
                         Color="@Order.Status.GetColor()"
                         Class="ma-0">
                    @Order.Status.GetGuestTitle()
                </MudChip>
            </MudStack>
        </MudStack>

        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
            @LinesText
        </MudText>

        @* Ordering again must not open the order as well *@
        <div @onclick:stopPropagation="true">
            <MudButton Variant="Variant.Outlined"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Replay"
                       OnClick="@OnOrderAgainClickAsync">
                Order again
            </MudButton>
        </div>
    </MudStack>
</MudPaper>