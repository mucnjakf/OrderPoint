<MudPaper Class="pa-3 cursor-pointer" @onclick="@OnRowClickAsync">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudImage Src="@(Item.ImageUrl ?? ImageUrls.Placeholder)"
                  Alt="Item image"
                  Width="56"
                  Height="56"
                  ObjectFit="ObjectFit.Cover"
                  Style="border-radius: var(--mud-default-borderradius); flex-shrink: 0;"/>

        <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
            <MudText Typo="Typo.body1" Style="@SingleLineStyle">
                @Item.Name
            </MudText>

            <MudText Typo="Typo.caption" Style="@($"color: var(--mud-palette-text-secondary); {SingleLineStyle}")">
                @DetailsText
            </MudText>
        </MudStack>

        <MudText Typo="Typo.body1" Style="font-weight: 600; white-space: nowrap">
            @Item.Price.ToString("C", CultureInfo.CurrentCulture)
        </MudText>

        @* Adding must not open the item as well *@
        <div @onclick:stopPropagation="true">
            <MudBadge Content="@CartQuantity" Visible="@(CartQuantity > 0)" Color="Color.Primary" Overlap="true">
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(CartQuantity >= CartService.MaxQuantity)"
                               aria-label="@($"Add {Item.Name} to the cart")"
                               OnClick="@OnAddClickAsync"/>
            </MudBadge>
        </div>
    </MudStack>
</MudPaper>