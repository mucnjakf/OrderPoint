<MudPaper Class="pa-3 cursor-pointer" @onclick="@OnRowClickAsync">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudImage Src="@(Item.ImageUrl ?? ImageUrls.Placeholder)"
                  Alt="Item image"
                  Width="56"
                  Height="56"
                  ObjectFit="ObjectFit.Cover"
                  Style="border-radius: var(--mud-default-borderradius); flex-shrink: 0;"/>

        <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
            <MudText Typo="Typo.body1" Style="@SingleLineStyle">
                @Item.Name
            </MudText>

            <MudText Typo="Typo.body2" Style="font-weight: 600">
                @Item.Price.ToString("C", CultureInfo.CurrentCulture)
            </MudText>

            <MudText Typo="Typo.caption" Style="@($"color: var(--mud-palette-text-secondary); {SingleLineStyle}")">
                @DetailsText
            </MudText>
        </MudStack>

        @* Changing the cart must not open the item as well *@
        <div @onclick:stopPropagation="true">
            @if (CartQuantity == 0)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               aria-label="@($"Add {Item.Name} to the cart")"
                               OnClick="@OnAddClickAsync"/>
            }
            else
            {
                <QuantityStepper Value="@CartQuantity"
                                 ValueChanged="@OnCartQuantityChangedAsync"
                                 Min="0"
                                 Max="@CartService.MaxQuantity"/>
            }
        </div>
    </MudStack>
</MudPaper>