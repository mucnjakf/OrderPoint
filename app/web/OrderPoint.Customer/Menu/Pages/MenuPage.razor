@page "/"

<PageTitle>Menu</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    Menu
</MudText>

<MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
    @Subtitle
</MudText>

<div style="@SearchWrapperStyle">
    <MudTextField @bind-Value="@SearchQuery"
                  T="string"
                  Placeholder="Search the menu"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  DebounceInterval="300"
                  Immediate="true"/>
</div>

@if (IsSearching)
{
    <StatefulView IsLoading="@IsLoading"
                  ShowContent="@FoundItems.Any()"
                  EmptyStateIcon="@Icons.Material.Filled.SearchOff"
                  EmptyStateText="Nothing found"
                  EmptyStateDetail="Try another name.">
        <MudStack Spacing="2">
            @foreach ((MenuCategoryDto category, MenuItemDto item) in FoundItems)
            {
                <MenuItemRow @key="@item.Id"
                             Item="@item"
                             CategoryName="@category.Name"
                             OnClick="@(() => OpenItem(category, item))"/>
            }
        </MudStack>
    </StatefulView>
}
else
{
    <StatefulView IsLoading="@IsLoading"
                  ShowContent="@Categories.Any()"
                  EmptyStateIcon="@Icons.Material.Filled.MenuBook"
                  EmptyStateText="The menu is empty"
                  EmptyStateDetail="Please ask the staff what they can serve.">
        <LoadingContent>
            <MudGrid Spacing="2">
                @for (int i = 0; i < LoadingCardsCount; i++)
                {
                    <MudItem xs="6" sm="4">
                        <MenuCategoryCardSkeleton/>
                    </MudItem>
                }
            </MudGrid>
        </LoadingContent>

        <ChildContent>
            <MudGrid Spacing="2">
                @foreach (MenuCategoryDto category in Categories)
                {
                    <MudItem @key="@category.Id" xs="6" sm="4">
                        <MenuCategoryCard Category="@category" OnClick="@OpenCategory"/>
                    </MudItem>
                }
            </MudGrid>
        </ChildContent>
    </StatefulView>
}