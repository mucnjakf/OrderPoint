@page "/"

<PageTitle>Menu</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    Menu
</MudText>

<MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
    @Subtitle
</MudText>

<div style="@SearchWrapperStyle">
    <MudTextField @bind-Value="@SearchQuery"
                  T="string"
                  Placeholder="Search categories"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  DebounceInterval="300"
                  Immediate="true"/>
</div>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@FoundCategories.Any()"
              EmptyStateIcon="@EmptyStateIcon"
              EmptyStateText="@EmptyStateText"
              EmptyStateDetail="@EmptyStateDetail">
    <LoadingContent>
        <MudGrid Spacing="2">
            @for (int i = 0; i < LoadingCardsCount; i++)
            {
                <MudItem xs="6" sm="4">
                    <MenuCategoryCardSkeleton/>
                </MudItem>
            }
        </MudGrid>
    </LoadingContent>

    <ChildContent>
        <MudGrid Spacing="2">
            @foreach (MenuCategoryDto category in FoundCategories)
            {
                <MudItem @key="@category.Id" xs="6" sm="4">
                    <MenuCategoryCard Category="@category" OnClick="@OpenCategory"/>
                </MudItem>
            }
        </MudGrid>
    </ChildContent>
</StatefulView>