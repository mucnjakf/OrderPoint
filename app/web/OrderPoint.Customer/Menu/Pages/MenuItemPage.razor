@page "/menu/{CategoryId:guid}/items/{ItemId:guid}"

<PageTitle>@(Item?.Name ?? "Item")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Href="@($"/menu/{CategoryId}")"
                   aria-label="Back to the category"/>

    <MudText Typo="Typo.h6" HtmlTag="h1" Class="flex-1" Style="min-width: 0; overflow-wrap: anywhere">
        @if (IsLoading)
        {
            <MudSkeleton Width="140px"/>
        }
        else
        {
            @(Item?.Name ?? "Item")
        }
    </MudText>
</MudStack>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@(Item is not null)"
              EmptyStateIcon="@Icons.Material.Filled.MenuBook"
              EmptyStateText="Item not found"
              EmptyStateDetail="It may have been taken off the menu.">
    <LoadingContent>
        <MenuItemDetailsSkeleton/>
    </LoadingContent>

    <ChildContent>
        <MudCard>
            <ItemCardContent ImageUrl="@Item!.ImageUrl"
                             IsActive="true"
                             ShowsStatus="false"
                             CategoryName="@Category!.Name"
                             CategoryImageUrl="@Category.ImageUrl"
                             Name="@Item.Name"
                             Description="@Item.Description"
                             Price="@Item.Price"
                             Portion="@Item.Portion"
                             IsDescriptionClamped="false"/>
        </MudCard>

        <MudPaper Class="pa-3 mt-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <QuantityStepper @bind-Value="@Quantity" Max="@Math.Max(1, MaxQuantityToAdd)"/>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="flex-1"
                           StartIcon="@Icons.Material.Filled.AddShoppingCart"
                           Disabled="@(MaxQuantityToAdd == 0)"
                           OnClick="@AddToCartAsync">
                    @AddButtonText
                </MudButton>
            </MudStack>

            @if (CartQuantity > 0)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-2" Style="color: var(--mud-palette-text-secondary)">
                    @CartQuantity in your cart already
                </MudText>
            }
        </MudPaper>
    </ChildContent>
</StatefulView>