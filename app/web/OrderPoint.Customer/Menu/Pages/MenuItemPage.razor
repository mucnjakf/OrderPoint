@page "/menu/{CategoryId:guid}/items/{ItemId:guid}"

<PageTitle>@(Item?.Name ?? "Item")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   Href="@($"/menu/{CategoryId}")"
                   aria-label="Back to the category"/>

    <MudText Typo="Typo.h6" HtmlTag="h1" Class="flex-1" Style="min-width: 0; overflow-wrap: anywhere">
        @if (IsLoading)
        {
            <MudSkeleton Width="140px"/>
        }
        else
        {
            @(Item?.Name ?? "Item")
        }
    </MudText>
</MudStack>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@(Item is not null)"
              EmptyStateIcon="@Icons.Material.Filled.MenuBook"
              EmptyStateText="Item not found"
              EmptyStateDetail="It may have been taken off the menu.">
    <LoadingContent>
        <MenuItemDetailsSkeleton/>
    </LoadingContent>

    <ChildContent>
        <MudCard>
            <ItemCardContent ImageUrl="@Item!.ImageUrl"
                             IsActive="true"
                             ShowsStatus="false"
                             CategoryName="@Category!.Name"
                             CategoryImageUrl="@Category.ImageUrl"
                             Name="@Item.Name"
                             Description="@Item.Description"
                             Price="@Item.Price"
                             IsDescriptionClamped="false"/>
        </MudCard>

        <MudPaper Class="pa-3 mt-3">
            @if (CartQuantity == 0)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <QuantityStepper @bind-Value="@Quantity" Max="@CartService.MaxQuantity"/>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Class="flex-1"
                               StartIcon="@Icons.Material.Filled.AddShoppingCart"
                               OnClick="@AddToCartAsync">
                        @AddButtonText
                    </MudButton>
                </MudStack>
            }
            else
            {
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body1">
                            In your cart
                        </MudText>

                        <QuantityStepper Value="@CartQuantity"
                                         ValueChanged="@OnCartQuantityChangedAsync"
                                         Min="0"
                                         Max="@CartService.MaxQuantity"/>
                    </MudStack>

                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Large"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.ShoppingCart"
                               Href="/cart">
                        View cart
                    </MudButton>
                </MudStack>
            }
        </MudPaper>
    </ChildContent>
</StatefulView>