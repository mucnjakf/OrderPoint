@page "/table"

<PageTitle>Table</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-3">
    Table
</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Style="color: var(--mud-palette-text-secondary)"/>

        @if (TableService.TableCode is null)
        {
            <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary)">
                No table yet: scan the QR code on your table.
            </MudText>
        }
        else
        {
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@TableText</MudText>

                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                    Orders go here for 12 hours after scanning. Scan another QR code to change it.
                </MudText>
            </MudStack>
        }
    </MudStack>
</MudPaper>

@if (TableService.TableCode is not null)
{
    <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mt-5">
        Need something?
    </MudText>

    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
        A bartender comes to your table.
    </MudText>

    <MudStack Spacing="3">
        @foreach (TableRequestType type in Enum.GetValues<TableRequestType>())
        {
            TableRequestType requestType = type;

            @if (IsLoading)
            {
                <TableRequestCardSkeleton/>
            }
            else
            {
                <TableRequestCard Type="@requestType"
                                  OpenRequest="@GetOpenRequest(requestType)"
                                  IsSending="@(SendingType == requestType)"
                                  OnRequest="@CreateRequestAsync"/>
            }
        }
    </MudStack>
}