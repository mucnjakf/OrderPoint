@page "/table"

<PageTitle>Your table</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    Your table
</MudText>

@if (TableService.TableCode is null)
{
    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
        No table yet: scan the QR code on your table.
    </MudText>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
        @TableText · A bartender comes to you.
    </MudText>

    <MudStack Spacing="3">
        @foreach (TableRequestType type in Enum.GetValues<TableRequestType>())
        {
            TableRequestType requestType = type;

            @if (IsLoading)
            {
                <TableRequestCardSkeleton/>
            }
            else
            {
                <TableRequestCard Type="@requestType"
                                  OpenRequest="@GetOpenRequest(requestType)"
                                  IsSending="@(SendingType == requestType)"
                                  OnRequest="@CreateRequestAsync"/>
            }
        }
    </MudStack>
}