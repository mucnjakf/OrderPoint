@page "/t/{TableCode}"

<PageTitle>OrderPoint</PageTitle>

@if (IsUnavailable)
{
    <StatusMessage Icon="@Icons.Material.Filled.TableRestaurant"
                   Title="Table not available"
                   Text="This table can't take orders right now. Please ask the staff."
                   Caption="@($"Table {TableCode}")"
                   ButtonText="Go to the menu"
                   ButtonIcon="@Icons.Material.Filled.MenuBook"/>
}