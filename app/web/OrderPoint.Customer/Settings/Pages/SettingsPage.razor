@page "/settings"

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-3">
    Settings
</MudText>

<MudPaper Class="pa-5">
    <SettingsSection Icon="@Icons.Material.Filled.Contrast"
                     Title="Appearance"
                     Description="Follow your phone, or pick light or dark. Remembered on this phone.">
        <MudToggleGroup T="AppearanceMode"
                        Value="@AppearanceService.Mode"
                        ValueChanged="@OnAppearanceModeChangedAsync"
                        Color="Color.Primary"
                        Style="width: 100%;">
            @foreach ((AppearanceMode mode, string icon) in AppearanceModes)
            {
                <MudToggleItem Value="@mode" Class="px-4 py-2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                        <MudIcon Icon="@icon" Size="Size.Small"/>
                        <MudText Typo="Typo.body2">@mode.ToString()</MudText>
                    </MudStack>
                </MudToggleItem>
            }
        </MudToggleGroup>
    </SettingsSection>

    <MudDivider Class="my-5"/>

    <SettingsSection Icon="@Icons.Material.Filled.TableRestaurant"
                     Title="Your table"
                     Description="Orders go to this table. Scan the QR code on another table to change it.">
        <MudPaper Outlined="true" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Style="color: var(--mud-palette-text-secondary)"/>

                @if (TableService.TableCode is not null)
                {
                    <MudText Typo="Typo.h6">
                        Table @TableService.TableCode
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary)">
                        No table yet: scan the QR code on your table.
                    </MudText>
                }
            </MudStack>
        </MudPaper>
    </SettingsSection>

    <MudDivider Class="my-5"/>

    <SettingsSection Icon="@Icons.Material.Filled.Receipt"
                     Title="Your orders"
                     Description="Orders placed on this phone stay in My orders for 12 hours.">
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Large"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.DeleteOutline"
                   Disabled="@(MyOrdersService.OrderIds.Count == 0)"
                   OnClick="@ForgetOrdersAsync">
            Forget this phone's orders
        </MudButton>
    </SettingsSection>
</MudPaper>