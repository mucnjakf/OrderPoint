<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <OrderCardDetails Order="@Order"/>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="flex-1 py-2"
                       StartIcon="@Icons.Material.Filled.Payments"
                       Disabled="@IsPaying"
                       OnClick="@OnPayInCashClickAsync">
                Cash
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Class="flex-1 py-2"
                       StartIcon="@Icons.Material.Filled.CreditCard"
                       Disabled="@IsPaying"
                       OnClick="@OnPayByCardClickAsync">
                Card
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>