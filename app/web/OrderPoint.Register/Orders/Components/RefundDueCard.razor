<MudPaper Class="pa-4" Style="height: 100%">
    <MudStack Spacing="3" Style="height: 100%">
        <OrderCardDetails Order="@Order"/>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-auto">
            <MudIcon Icon="@MethodIcon" Size="Size.Small" Style="color: var(--mud-palette-text-secondary)"/>

            <MudText Typo="Typo.body2">
                @MethodText
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   Class="py-2"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.AssignmentReturn"
                   Disabled="@IsRefunding"
                   OnClick="@OnHandBackClickAsync">
            @HandBackText
        </MudButton>
    </MudStack>
</MudPaper>