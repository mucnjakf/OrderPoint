<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="72px" Height="40px"/>

            <MudStack Spacing="0" Class="flex-1">
                <MudText Typo="Typo.h6">
                    <MudSkeleton Width="50%"/>
                </MudText>

                <MudText Typo="Typo.caption">
                    <MudSkeleton Width="60%"/>
                </MudText>
            </MudStack>

            <ChipSkeleton/>
        </MudStack>

        <MudStack Spacing="1">
            <MudText Typo="Typo.body2">
                <MudSkeleton Width="55%"/>
            </MudText>

            <MudText Typo="Typo.body2">
                <MudSkeleton Width="70%"/>
            </MudText>
        </MudStack>

        <MudDivider/>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="32px" Height="32px"/>

            <MudText Typo="Typo.body2" Class="flex-1">
                <MudSkeleton Width="60%"/>
            </MudText>
        </MudStack>

        <MudText Typo="Typo.h5" Align="Align.Right">
            <MudSkeleton Width="30%" Class="ml-auto"/>
        </MudText>

        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="40px"/>
    </MudStack>
</MudPaper>