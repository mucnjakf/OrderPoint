<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Receipt"/>
            <MudText Typo="Typo.h6">Order #@Order.Number</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="4">
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@StatusIcon" Color="@StatusColor" Style="font-size: 56px"/>

                <MudText Typo="Typo.h6">
                    @StatusText
                </MudText>

                <MudText Typo="Typo.h3" Style="font-weight: 700">
                    @Order.Total.ToString("C", CultureInfo.CurrentCulture)
                </MudText>

                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                    @PaymentText
                </MudText>
            </MudStack>

            @if (ChangeGiven is { } change)
            {
                <MudPaper Elevation="0" Class="pa-4" Style="@ChangeStyle">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.CurrencyExchange" Color="Color.Success"/>
                            <MudText Typo="Typo.subtitle1">Change to give</MudText>
                        </MudStack>

                        <MudText Typo="Typo.h4" Style="font-weight: 700">
                            @change.ToString("C", CultureInfo.CurrentCulture)
                        </MudText>
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@Order.GetPlaceText()</MudText>

                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                            @PaidAtText
                        </MudText>
                    </MudStack>

                    <MudDivider/>

                    @foreach (OrderItemDto orderItem in Order.Items)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudImage Src="@(orderItem.ImageUrl ?? ImageUrls.Placeholder)"
                                      Alt="Item image"
                                      Width="32"
                                      Height="32"
                                      ObjectFit="ObjectFit.Cover"
                                      Style="@($"{ImageStyles.Rounded} flex-shrink: 0;")"/>

                            <MudText Typo="Typo.body2" Class="flex-1">
                                <strong>@orderItem.Quantity×</strong> @orderItem.Name
                            </MudText>

                            <MudText Typo="Typo.body2">
                                @((orderItem.Quantity * orderItem.UnitPrice).ToString("C", CultureInfo.CurrentCulture))
                            </MudText>
                        </MudStack>
                    }

                    @if (Order.PaidByBartender is { } paidBy)
                    {
                        <MudDivider/>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <BartenderAvatar FirstName="@paidBy.FirstName"
                                             LastName="@paidBy.LastName"
                                             ImageUrl="@paidBy.ImageUrl"
                                             Size="Size.Small"/>

                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                                Served by @paidBy.FirstName @paidBy.LastName
                            </MudText>
                        </MudStack>
                    }
                </MudStack>
            </MudPaper>

            @* The printed receipt: hidden here, copied into a frame by Print *@
            <div style="display: none">
                <Receipt @ref="@ReceiptComponent" Order="@Order"/>
            </div>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@PrintAsync"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Print"
                   Class="mr-auto">
            Print
        </MudButton>

        <MudButton OnClick="@Close" Variant="Variant.Filled" Color="Color.Primary">
            Done
        </MudButton>
    </DialogActions>
</MudDialog>