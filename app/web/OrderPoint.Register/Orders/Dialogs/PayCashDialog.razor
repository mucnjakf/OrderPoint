<MudDialog ActionsClass="pa-6" Class="mud-background">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Payments"/>
            <MudText Typo="Typo.h6">Cash payment</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="4">
            <MudPaper Elevation="0" Class="pa-4" Style="@TotalStyle">
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                    To pay
                </MudText>

                <MudText Typo="Typo.h3" Style="font-weight: 700">
                    @Total.ToString("C", CultureInfo.CurrentCulture)
                </MudText>
            </MudPaper>

            <MudNumericField @bind-Value="@Received"
                             T="decimal?"
                             Label="Received from the guest"
                             Adornment="Adornment.Start"
                             AdornmentText="€"
                             Min="0"
                             Max="@MaxCashReceived"
                             HideSpinButtons="true"
                             Variant="Variant.Outlined"
                             Immediate="true"
                             AutoFocus="true"/>

            <div style="@QuickAmountsStyle">
                @foreach (decimal amount in QuickAmounts)
                {
                    decimal quickAmount = amount;

                    <MudButton Variant="@(Received == quickAmount ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               Class="py-3"
                               OnClick="@(() => Received = quickAmount)">
                        <MudStack Spacing="0" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600">
                                @quickAmount.ToString("C", CultureInfo.CurrentCulture)
                            </MudText>

                            <MudText Typo="Typo.caption">
                                @(quickAmount == Total ? "Exact" : "Note")
                            </MudText>
                        </MudStack>
                    </MudButton>
                }
            </div>

            <MudPaper Elevation="0" Class="pa-4" Style="@ChangeBoxStyle">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@ChangeIcon" Color="@ChangeColor"/>
                        <MudText Typo="Typo.subtitle1">@ChangeLabel</MudText>
                    </MudStack>

                    <MudText Typo="Typo.h4" Style="font-weight: 700">
                        @ChangeText
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel" Variant="Variant.Text" Class="mr-5">
            Back
        </MudButton>

        <MudButton OnClick="@Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   Disabled="@(!IsEnough)"
                   StartIcon="@Icons.Material.Filled.Payments">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>