@page "/to-pay"

<PageTitle>To pay</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    To pay
</MudText>

<MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
    Orders taken in the Bartender app and guests' cash orders from the customer app, paid here. Oldest first.
</MudText>



<StatefulView IsLoading="@IsLoading"
              ShowContent="@(Orders.Count != 0)"
              EmptyStateIcon="@Icons.Material.Filled.TaskAlt"
              EmptyStateText="Nothing to pay"
              EmptyStateDetail="Every order is paid.">
    <LoadingContent>
        <div style="@OrderCardsLayout.GridStyle">
            @for (int i = 0; i < LoadingCardsCount; i++)
            {
                <OrderCardSkeleton/>
            }
        </div>
    </LoadingContent>

    <ChildContent>
        <div style="@OrderCardsLayout.GridStyle">
            @foreach (OrderDto order in Orders)
            {
                <UnpaidOrderCard @key="@order.Id"
                                 Order="@order"
                                 IsPaying="@(PayingOrderId == order.Id)"
                                 OnPayInCash="@PayInCashAsync"
                                 OnPayByCard="@PayByCardAsync"/>
            }
        </div>
    </ChildContent>
</StatefulView>