@page "/to-pay"

<PageTitle>To pay</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    To pay
</MudText>

<MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
    Orders taken in the Bartender app, paid here before the guest leaves. Oldest first.
</MudText>

<MudTextField @bind-Value="@SearchQuery"
              @bind-Value:after="@OnSearchChangedAsync"
              T="string"
              Placeholder="Order number, table or name"
              Variant="Variant.Outlined"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Clearable="true"
              DebounceInterval="300"
              Immediate="true"
              Class="mb-3"
              Style="max-width: 480px"/>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@(Orders.Count != 0)"
              EmptyStateIcon="@(IsSearching ? Icons.Material.Filled.SearchOff : Icons.Material.Filled.TaskAlt)"
              EmptyStateText="@(IsSearching ? "Nothing found" : "Nothing to pay")"
              EmptyStateDetail="@(IsSearching ? "Try another number, table or name." : "Every order is paid.")">
    <LoadingContent>
        <div style="@OrderCardsLayout.GridStyle">
            @for (int i = 0; i < LoadingCardsCount; i++)
            {
                <OrderCardSkeleton/>
            }
        </div>
    </LoadingContent>

    <ChildContent>
        <div style="@OrderCardsLayout.GridStyle">
            @foreach (OrderDto order in Orders)
            {
                <UnpaidOrderCard @key="@order.Id"
                                 Order="@order"
                                 IsPaying="@(PayingOrderId == order.Id)"
                                 OnPayInCash="@PayInCashAsync"
                                 OnPayByCard="@PayByCardAsync"/>
            }
        </div>
    </ChildContent>
</StatefulView>