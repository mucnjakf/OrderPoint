@page "/refunds"

<PageTitle>Refunds due</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    Refunds due
</MudText>

<MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
    Orders paid here that the bar declined or the guest cancelled: give the money back the way it came.
</MudText>

<StatefulView IsLoading="@IsLoading"
              ShowContent="@(Orders.Count != 0)"
              EmptyStateIcon="@Icons.Material.Filled.TaskAlt"
              EmptyStateText="No refunds due"
              EmptyStateDetail="Nothing to hand back.">
    <LoadingContent>
        <div style="@OrderCardsLayout.GridStyle">
            <OrderCardSkeleton/>
        </div>
    </LoadingContent>

    <ChildContent>
        <div style="@OrderCardsLayout.GridStyle">
            @foreach (OrderDto order in Orders)
            {
                <RefundDueCard @key="@order.Id"
                               Order="@order"
                               IsRefunding="@(RefundingOrderId == order.Id)"
                               OnHandBack="@HandBackAsync"/>
            }
        </div>
    </ChildContent>
</StatefulView>