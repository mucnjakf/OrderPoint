@page "/"

<PageTitle>Today</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1">
    Today
</MudText>

<MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
    What was paid since @DayStartText
</MudText>

<MudGrid Spacing="3" Class="mb-3">
    @if (Day is null)
    {
        @for (int i = 0; i < TilesCount; i++)
        {
            <MudItem xs="3">
                <TodayTileSkeleton/>
            </MudItem>
        }
    }
    else
    {
        <MudItem xs="3">
            <TodayTile Icon="@Icons.Material.Filled.Payments"
                       Title="Cash in the till"
                       Value="@Day.CashTotal"
                       Caption="Taken here today"/>
        </MudItem>

        <MudItem xs="3">
            <TodayTile Icon="@Icons.Material.Filled.CreditCard"
                       Title="Card at the register"
                       Value="@Day.CardTotal"
                       Caption="On the bar's terminal"/>
        </MudItem>

        <MudItem xs="3">
            <TodayTile Icon="@Icons.Material.Filled.PhoneIphone"
                       Title="Card online"
                       Value="@Day.OnlineCardTotal"
                       Caption="Guests in the customer app"/>
        </MudItem>

        <MudItem xs="3">
            <TodayTile Icon="@Icons.Material.Filled.AssignmentReturn"
                       Title="Refunds due"
                       Value="@Day.RefundsDueTotal"
                       Caption="@Day.RefundsDueCount.ToCountText("order", "orders")"/>
        </MudItem>
    }
</MudGrid>

<MudGrid Spacing="3">
    <MudItem xs="4">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height: 100%; min-height: 220px;">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-3">
                Per bartender
            </MudText>

            <StatefulView IsLoading="@(Day is null)"
                          ShowContent="@(Day?.Bartenders.Count > 0)"
                          Compact="true"
                          EmptyStateIcon="@Icons.Material.Filled.People"
                          EmptyStateText="No payments taken yet">
                <MudStack Spacing="2">
                    @foreach (RegisterBartenderDto bartender in Day!.Bartenders)
                    {
                        RegisterBartenderDto rowBartender = bartender;

                        <MudPaper @key="@rowBartender.Id"
                                  Outlined="true"
                                  Class="pa-3 cursor-pointer"
                                  Style="@GetBartenderRowStyle(rowBartender)"
                                  @onclick="@(() => ToggleBartenderAsync(rowBartender.Id))"
                                  @onmouseenter="@(() => HoveredBartenderId = rowBartender.Id)"
                                  @onmouseleave="@(() => HoveredBartenderId = null)">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <BartenderAvatar FirstName="@rowBartender.FirstName"
                                                 LastName="@rowBartender.LastName"
                                                 ImageUrl="@rowBartender.ImageUrl"/>

                                <MudStack Spacing="0" Class="flex-1" Style="min-width: 0">
                                    <MudText Typo="Typo.body2">
                                        @rowBartender.FirstName @rowBartender.LastName
                                    </MudText>

                                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                                        @GetBartenderText(rowBartender)
                                    </MudText>
                                </MudStack>

                                <MudText Typo="Typo.body1" Style="font-weight: 600">
                                    @GetBartenderTotalText(rowBartender)
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </StatefulView>
        </MudPaper>
    </MudItem>

    <MudItem xs="8">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height: 100%; min-height: 220px;">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-3">
                Payments
            </MudText>

            <MudStack Row="true" AlignItems="AlignItems.End" Class="mb-3">
                @* As wide as its label; a text field on its own grows to fill the row *@
                <div style="width: 300px; flex-shrink: 0">
                    <MudTextField @bind-Value="@SearchQuery"
                                  @bind-Value:after="@OnFiltersChangedAsync"
                                  T="string"
                                  Label="Search by number, table or name"
                                  Variant="Variant.Outlined"
                                  Clearable="true"
                                  DebounceInterval="300"
                                  Immediate="true"/>
                </div>

                <MudSelect @bind-Value="@SelectedChannel"
                           @bind-Value:after="@OnFiltersChangedAsync"
                           T="PaymentChannel?"
                           Label="How"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           FitContent="true">
                    @foreach (PaymentChannel channel in Enum.GetValues<PaymentChannel>())
                    {
                        <MudSelectItem T="PaymentChannel?" Value="@channel">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@channel.GetIcon()" Size="Size.Small"/>
                                <MudText Typo="Typo.body1">@channel.GetLabel()</MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="@SelectedBartenderId"
                           @bind-Value:after="@OnFiltersChangedAsync"
                           T="Guid?"
                           Label="Paid by"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           FitContent="true"
                           ToStringFunc="@GetBartenderName">
                    @foreach (RegisterBartenderDto bartender in Day?.Bartenders ?? [])
                    {
                        <MudSelectItem T="Guid?" Value="@bartender.Id">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <BartenderAvatar FirstName="@bartender.FirstName"
                                                 LastName="@bartender.LastName"
                                                 ImageUrl="@bartender.ImageUrl"
                                                 Size="Size.Small"/>

                                <MudText Typo="Typo.body1">@bartender.FirstName @bartender.LastName</MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect @bind-Value="@SelectedSortBy"
                           @bind-Value:after="@OnFiltersChangedAsync"
                           T="string"
                           Label="Sort by"
                           Variant="Variant.Outlined"
                           FitContent="true">
                    @foreach (string sortBy in Enum.GetNames<PaymentSortBy>())
                    {
                        <MudSelectItem Value="@sortBy">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.body1">@PaymentSorting.GetSortByLabel(sortBy)</MudText>
                                <MudIcon Icon="@PaymentSorting.GetSortByIcon(sortBy)" Size="Size.Small"/>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            <StableHeight IsLoading="@IsLoadingPayments"
                          KeepHeight="@(Pagination?.PageNumber > 1)"
                          Class="flex-grow-1 d-flex flex-column">
                <StatefulView IsLoading="@IsLoadingPayments"
                              ShowContent="@(Payments.Count != 0)"
                              Compact="true"
                              EmptyStateIcon="@Icons.Material.Filled.ReceiptLong"
                              EmptyStateText="@PaymentsEmptyText">
                    <MudSimpleTable Hover="true" Elevation="0">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Place</th>
                                <th>Paid</th>
                                <th>How</th>
                                <th>By</th>
                                <th style="text-align: right">Total</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (OrderDto order in Payments)
                            {
                                OrderDto rowOrder = order;
                                PaymentChannel? channel = rowOrder.GetPaymentChannel();

                                <tr @key="@rowOrder.Id">
                                    <td style="font-weight: 600">#@rowOrder.Number</td>
                                    <td>@rowOrder.GetPlaceText()</td>
                                    <td>@rowOrder.PaidAtUtc!.Value.ToDisplayDateTime(TimeZoneService.TimeZone)</td>
                                    <td>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@(channel?.GetIcon())"
                                                     Size="Size.Small"
                                                     Style="color: var(--mud-palette-text-secondary)"/>

                                            <span>@channel?.GetLabel()</span>
                                        </MudStack>
                                    </td>
                                    <td>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            @if (rowOrder.PaidByBartender is { } paidBy)
                                            {
                                                <BartenderAvatar FirstName="@paidBy.FirstName"
                                                                 LastName="@paidBy.LastName"
                                                                 ImageUrl="@paidBy.ImageUrl"
                                                                 Size="Size.Small"/>

                                                <span>@paidBy.FirstName @paidBy.LastName</span>
                                            }
                                            else
                                            {
                                                <span style="color: var(--mud-palette-text-secondary)">Guest</span>
                                            }
                                        </MudStack>
                                    </td>
                                    <td style="text-align: right; font-weight: 600">
                                        @rowOrder.Total.ToString("C", CultureInfo.CurrentCulture)
                                    </td>
                                    <td style="text-align: right">
                                        <MudTooltip Text="Receipt">
                                            <MudIconButton Icon="@Icons.Material.Filled.Receipt"
                                                           Size="Size.Small"
                                                           aria-label="Show the receipt"
                                                           OnClick="@(() => ShowReceiptAsync(rowOrder))"/>
                                        </MudTooltip>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </StatefulView>
            </StableHeight>

            <ListPager TItem="OrderDto"
                       Pagination="@Pagination"
                       IsLoading="@IsLoadingPayments"
                       OnPageChanged="@OnPageChangedAsync"/>
        </MudPaper>
    </MudItem>
</MudGrid>