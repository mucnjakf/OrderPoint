@page "/account"

<PageTitle>Account</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-3">
    Account
</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-5 d-flex flex-column align-center justify-center gap-3" Style="height: 100%">
            <MudAvatar Color="Color.Primary" Style="width: 96px; height: 96px; font-size: 2rem;">
                @if (AccountService.ImageUrl is not null)
                {
                    <MudImage Src="@AccountService.ImageUrl" Alt="Account image" ObjectFit="ObjectFit.Cover"/>
                }
                else
                {
                    @Initials
                }
            </MudAvatar>

            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h6" Align="Align.Center" Style="overflow-wrap: anywhere">
                    @(FullName ?? AuthService.Email)
                </MudText>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Secondary"/>
                    <MudText Typo="Typo.body2"
                             Style="color: var(--mud-palette-text-secondary); overflow-wrap: anywhere">
                        @AuthService.Email
                    </MudText>
                </MudStack>

                @if (AccountService.PhoneNumber is not null)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary"/>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                            @AccountService.PhoneNumber
                        </MudText>
                    </MudStack>
                }
            </MudStack>

            <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="ma-0">
                Bartender
            </MudChip>

            <MudText Typo="Typo.caption" Align="Align.Center" Style="color: var(--mud-palette-text-secondary)">
                Your name, email, phone number and photo are set by the admin.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="8">
        <MudPaper Class="pa-5" Style="height: 100%">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Contrast"/>

                <MudStack Spacing="0" Class="flex-1">
                    <MudText Typo="Typo.subtitle1">
                        Appearance
                    </MudText>

                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                        Light or dark colours, remembered in this browser.
                    </MudText>
                </MudStack>

                <MudToggleGroup T="bool"
                                Value="@DarkModeService.IsDarkMode"
                                ValueChanged="@OnDarkModeChangedAsync"
                                Color="Color.Primary"
                                Size="Size.Small">
                    <MudToggleItem Value="false" Class="px-4 py-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.LightMode" Size="Size.Small"/>
                            <MudText Typo="Typo.body2">Light</MudText>
                        </MudStack>
                    </MudToggleItem>

                    <MudToggleItem Value="true" Class="px-4 py-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small"/>
                            <MudText Typo="Typo.body2">Dark</MudText>
                        </MudStack>
                    </MudToggleItem>
                </MudToggleGroup>
            </MudStack>

            <MudDivider Class="my-5"/>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Password"/>

                <MudStack Spacing="0" Class="flex-1">
                    <MudText Typo="Typo.subtitle1">
                        Password
                    </MudText>

                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                        Change the password you sign in with. Other devices are signed out.
                    </MudText>
                </MudStack>

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="@ShowChangePasswordDialogAsync">
                    Change password
                </MudButton>
            </MudStack>

            <MudDivider Class="my-5"/>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Devices"/>

                <MudStack Spacing="0" Class="flex-1">
                    <MudText Typo="Typo.subtitle1">
                        Sessions
                    </MudText>

                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                        Sign out of every device signed in with this account, including this one.
                    </MudText>
                </MudStack>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.PhonelinkErase"
                           OnClick="@ShowSignOutEverywhereDialogAsync">
                    Sign out everywhere
                </MudButton>
            </MudStack>

            <MudDivider Class="my-5"/>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Logout"/>

                <MudStack Spacing="0" Class="flex-1">
                    <MudText Typo="Typo.subtitle1">
                        Sign out
                    </MudText>

                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">
                        Sign out of this browser.
                    </MudText>
                </MudStack>

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Logout"
                           OnClick="@ShowSignOutDialogAsync">
                    Sign out
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>