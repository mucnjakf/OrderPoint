<MudPaper Class="cursor-pointer d-flex flex-column" Style="@TileStyle" @onclick="@OnTileClickAsync">
    <ItemCardImage ImageUrl="@Item.ImageUrl" IsActive="true"/>

    @if (Quantity != 0)
    {
        <MudChip T="string"
                 Variant="Variant.Filled"
                 Color="Color.Primary"
                 Size="Size.Small"
                 Style="position: absolute; top: 8px; right: 8px; margin: 0;">
            @Quantity× on the sale
        </MudChip>
    }

    <MudStack Spacing="1" Class="pa-3 flex-grow-1">
        <MudText Typo="Typo.subtitle2" Style="@SaleLayout.TwoLinesStyle">
            @Item.Name
        </MudText>

        @if (!string.IsNullOrWhiteSpace(Item.Description))
        {
            <MudText Typo="Typo.caption" Style="@SaleLayout.SecondaryTwoLinesStyle">
                @Item.Description
            </MudText>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-auto pt-1">
            <MudText Typo="Typo.body1" Style="font-weight: 700">
                @Item.Price.ToString("C", CultureInfo.CurrentCulture)
            </MudText>

            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                Portion @Item.Portion.ToString(CultureInfo.CurrentCulture)
            </MudText>
        </MudStack>
    </MudStack>
</MudPaper>