@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" IsDarkMode="@DarkModeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" BackdropClick="false" Position="DialogPosition.Center" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

@if (!AuthService.IsLoaded)
{
    return;
}

@if (!AuthService.IsSignedIn)
{
    <LoginForm Role="UserRole.Bartender" AppName="Register web" />

    return;
}

<MudLayout>
    <MudAppBar Elevation="0" Style="border-bottom: 1px solid var(--mud-palette-lines-default)">
        <div class="d-flex align-center" style="@SideStyle">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudImage Src="@ImageUrls.Logo" Alt="OrderPoint logo" Width="36" Height="36" />

                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Style="line-height: 1.2">OrderPoint</MudText>
                    <MudText Typo="Typo.caption" Style="line-height: 1.2">Register</MudText>
                </MudStack>
            </MudStack>
        </div>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="6">
            <MudButton Href="/"
                       Variant="Variant.Text"
                       Class="px-4"
                       StartIcon="@Icons.Material.Filled.Today"
                       Style="@GetTabStyle("/")">
                Today
            </MudButton>

            <MudButton Href="/sales"
                       Variant="Variant.Text"
                       Class="px-4"
                       StartIcon="@Icons.Material.Filled.PointOfSale"
                       Style="@GetTabStyle("/sales")">
                Sale
            </MudButton>

            <MudButton Href="/to-pay"
                       Variant="Variant.Text"
                       Class="px-4"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       Style="@GetTabStyle("/to-pay")">
                To pay

                @if (ToPayCount is { } toPayCount)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 ml-2 px-3">
                        <RollingNumber Value="@toPayCount" Text="@toPayCount.ToString()"/>
                    </MudChip>
                }
            </MudButton>

            <MudButton Href="/refunds"
                       Variant="Variant.Text"
                       Class="px-4"
                       StartIcon="@Icons.Material.Filled.AssignmentReturn"
                       Style="@GetTabStyle("/refunds")">
                Refunds due

                @if (RefundsDueCount is { } refundsDueCount)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 ml-2 px-3">
                        <RollingNumber Value="@refundsDueCount" Text="@refundsDueCount.ToString()"/>
                    </MudChip>
                }
            </MudButton>

            <MudButton Href="/account"
                       Variant="Variant.Text"
                       Class="px-4"
                       StartIcon="@Icons.Material.Filled.Person"
                       Style="@GetTabStyle("/account")">
                Account
            </MudButton>
        </MudStack>

        <div class="d-flex align-center justify-end" style="@SideStyle">
            <LiveIndicator />
        </div>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="pa-3">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>